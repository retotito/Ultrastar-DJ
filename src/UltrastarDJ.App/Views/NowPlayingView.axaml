<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel"
             MinWidth="{StaticResource GamePlayerWidth}"
             ClipToBounds="False">

  <!-- The card's shadow reaches outside this control; see DjWindow.axaml. -->
  <UserControl.Styles>
    <Style Selector="UserControl /template/ ContentPresenter">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card floating">
    <!-- Shared-size scope: the song row and the mic rows share their name column. -->
    <StackPanel Spacing="{StaticResource Space2}" Grid.IsSharedSizeScope="True">
      <!-- Header like the sidebar popovers (DjWindow), and the drag handle of the card -->
      <Border x:Name="DragHandle" Background="Transparent" ToolTip.Tip="Drag to move"
              BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,0,0,1"
              Padding="0,0,0,8" Margin="0,0,0,4">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <c:Icon Grid.Column="0" Glyph="play_circle" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="title" Text="Game Player" VerticalAlignment="Center" />
          <c:Icon Grid.Column="2" Glyph="drag_indicator" Classes="muted" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Grid.Column="3" Classes="sidebar" Width="28" Height="28" Command="{Binding HideCommand}" ToolTip.Tip="Close (reopen from the sidebar)">
            <c:Icon Glyph="close" FontSize="{StaticResource IconMd}" />
          </Button>
        </Grid>
      </Border>

      <!-- Always there (fixed size), like the preview player: note when empty, loader while loading, then what the
           beamers show behind the game (Core.Playback.StageView): song picture, video while it runs, or backdrop. -->
      <Border Background="{DynamicResource BrushBeamerBackground}" CornerRadius="{StaticResource RadiusMd}" Height="{StaticResource GamePlayerPictureHeight}" ClipToBounds="True">
        <Panel>
          <Image Source="{Binding BoxImage}" Stretch="UniformToFill" IsVisible="{Binding ShowBoxImage}" />
          <c:VideoSurface Source="{Binding GameFrames}" IsVisible="{Binding ShowVideo}" />
          <c:Icon Glyph="music_note" FontSize="{StaticResource IconXl}" IsVisible="{Binding !HasSong}" />
          <!-- Countdown and pause as on the beamers (same text style), scaled to the box. -->
          <TextBlock Classes="beamer" Text="{Binding CountdownValue}" FontSize="110" FontWeight="{StaticResource WeightBold}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCountdown}" />
          <Border Background="#88000000" IsVisible="{Binding IsPaused}">
            <TextBlock Classes="beamer" Text="PAUSED" FontSize="40" FontWeight="{StaticResource WeightBold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <!-- Elapsed / remaining and the progress line, as at the bottom of the beamer. -->
          <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Bottom" IsVisible="{Binding HasTimes}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,8,6">
              <Border Background="{DynamicResource BrushStagePill}" CornerRadius="{StaticResource RadiusFull}" Padding="8,1">
                <TextBlock Classes="beamer" Text="{Binding Elapsed}" FontSize="{StaticResource TextXs}" FontWeight="{StaticResource WeightSemibold}" />
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource BrushStagePill}" CornerRadius="{StaticResource RadiusFull}" Padding="8,1">
                <TextBlock Classes="beamer" Text="{Binding Remaining}" FontSize="{StaticResource TextXs}" FontWeight="{StaticResource WeightSemibold}" />
              </Border>
            </Grid>
            <c:LevelMeter Grid.Row="1" Height="4" Level="{Binding Progress}" Fill="{DynamicResource BrushStageProgress}" Track="{DynamicResource BrushStageTrack}" />
          </Grid>
          <c:Spinner IsVisible="{Binding Loading}" />
        </Panel>
      </Border>
      <!-- Title / artist, and the DJ's marks on the loaded song: in the game is where a bad song shows. -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
          <!-- A duet: "Duet" and the button to assign the voices; who sings which voice shows under each mic slider.
               ⚠ while the players changed since the voices were assigned. -->
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding IsDuet}" Margin="0,16,0,0">
            <c:Icon Glyph="group" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" />
            <TextBlock Text="Duet" FontSize="{StaticResource TextBase}" FontWeight="{StaticResource WeightBold}" VerticalAlignment="Center" />
            <c:Icon Glyph="warning" FontSize="{StaticResource IconSm}" Foreground="{DynamicResource BrushError}" VerticalAlignment="Center"
                    IsVisible="{Binding VoicesUnconfirmed}" ToolTip.Tip="The players changed — assign the voices again" Background="Transparent" />
            <Button Classes="tonal" Padding="12,4" Command="{Binding ChangeDuetSingersCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Choose who sings which voice">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                <c:Icon Glyph="record_voice_over" FontSize="{StaticResource IconSm}" />
                <TextBlock Text="Assign voices" FontSize="{StaticResource TextSm}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasSong}">
          <StackPanel.Styles>
            <Style Selector="c|Icon.favourite">
              <Setter Property="Foreground" Value="{DynamicResource BrushFavourite}" />
            </Style>
            <Style Selector="c|Icon.broken">
              <Setter Property="Foreground" Value="{DynamicResource BrushError}" />
            </Style>
          </StackPanel.Styles>
          <Button Classes="sidebar small" Width="32" Height="32" Command="{Binding ToggleFavouriteCommand}"
                  ToolTip.Tip="{Binding IsFavourite, Converter={x:Static vm:BoolConverters.Text}, ConverterParameter='Remove from favourites|Favourite'}">
            <c:Icon Glyph="favorite" FontSize="{StaticResource IconMd}" Classes.favourite="{Binding IsFavourite}" />
          </Button>
          <Button Classes="sidebar small" Width="32" Height="32" Command="{Binding ToggleBrokenCommand}"
                  ToolTip.Tip="{Binding IsBroken, Converter={x:Static vm:BoolConverters.Text}, ConverterParameter='Not broken|Mark as broken (bad notes or timing) — never offered on the songbook; add a note in Details'}">
            <c:Icon Glyph="report" FontSize="{StaticResource IconMd}" Classes.broken="{Binding IsBroken}" />
          </Button>
        </StackPanel>
      </Grid>
      <!-- Requested on the songbook: who to call to the mic (same look as in the queue) -->
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,-4,0,0"
                  IsVisible="{Binding RequestedBy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="Requested on the songbook">
        <c:Icon Glyph="mic" FontSize="{StaticResource IconSm}" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding RequestedBy}" FontSize="{StaticResource TextXs}" FontWeight="{StaticResource WeightSemibold}"
                   Foreground="{DynamicResource BrushPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <!-- Status line hidden on purpose (the DJ doesn't need it); NowPlayingViewModel.Status still computes it. -->
        <TextBlock Classes="muted" FontSize="{StaticResource TextSm}" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="False" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" HorizontalAlignment="Center" Margin="0,0,0,8">
        <!-- Four buttons (prototype): rules in Core.Playback.PlaybackRules. Hidden while no beamer is open. -->
        <Button Classes="sidebar" Command="{Binding HomeCommand}" ToolTip.Tip="Displays to the start view (the song stays loaded)"
                IsVisible="{Binding !NoBeamerOpen}" VerticalAlignment="Center"><c:Icon Glyph="home" /></Button>
        <Button Classes="sidebar" Command="{Binding PreviewCommand}" ToolTip.Tip="Show the get-ready screen"
                IsVisible="{Binding !NoBeamerOpen}" VerticalAlignment="Center"><c:Icon Glyph="tv" /></Button>
        <Button Classes="transport" Classes.go="{Binding !IsPauseButton}" Classes.pause="{Binding IsPauseButton}"
                Command="{Binding PlayPauseCommand}" ToolTip.Tip="{Binding PlayTip}" IsVisible="{Binding !NoBeamerOpen}">
          <c:Icon Glyph="{Binding PlayGlyph}" FontSize="{StaticResource IconXl}" />
        </Button>
        <Button Classes="transport stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop — show the scores" IsVisible="{Binding !NoBeamerOpen}">
          <c:Icon Glyph="stop" FontSize="{StaticResource IconLg}" />
        </Button>

        <!-- Nothing to play on yet: one clear action instead of four dead buttons -->
        <Button Classes="tonal" Command="{Binding SelectDisplaysCommand}" IsVisible="{Binding NoBeamerOpen}"
                ToolTip.Tip="Opens Game Displays: open a display and choose which players sing on it">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <c:Icon Glyph="tv" FontSize="{StaticResource IconMd}" />
            <TextBlock Text="Select displays" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Song and mic mix: faders with their meter as the track (as in the preview and Audio Input).
           Columns shared with the mic rows: icon + name, fader, %. All meters put yellow at 80 % and red at 90 %
           of their range, so they look alike although song and mic use different dB ranges. -->
      <!-- No display open: nothing can play, so the song fader is invisible and inert — but keeps its space,
           so the card does not change height when a beamer opens. -->
      <Grid Classes.unused="{Binding NoBeamerOpen}">
        <!-- The name column is shared with the mic rows and grows with the longest label (translations later). -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MixName" />
          <ColumnDefinition Width="*" MinWidth="180" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <Grid.Styles>
          <Style Selector="Grid.unused">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
          </Style>
        </Grid.Styles>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
          <c:Icon Glyph="volume_up" FontSize="{StaticResource IconMd}" Width="28" TextAlignment="Center" Margin="32,0,0,0" />
          <TextBlock Classes="muted" FontSize="{StaticResource TextSm}" Text="Song" VerticalAlignment="Center" />
        </StackPanel>
        <c:MeterFader Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Gain}" Level="{Binding SongLevel}"
                      MinDb="-40" MaxDb="0" WarnDb="-8" ClipDb="-4" VerticalAlignment="Center" ToolTip.Tip="Song knob" />
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Gain, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" TextAlignment="Right" />
      </Grid>

      <!-- Mic mix: one row per player assigned to an open beamer. The mic in the player's colour is the mute button. -->
      <ItemsControl ItemsSource="{Binding MixRows}" IsVisible="{Binding HasMixRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MixRowViewModel">
            <Grid Margin="0,2,0,0" RowDefinitions="Auto,Auto">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MixName" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- The display this player sings on: a screen with its number. -->
                <Panel Width="28" Height="28" ToolTip.Tip="{Binding Display, StringFormat='Sings on Display {0}'}">
                  <c:Icon Glyph="tv" FontSize="{StaticResource IconLg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Display}" FontSize="10" FontWeight="{StaticResource WeightBold}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                </Panel>
                <Button Classes="sidebar small" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute in the speakers">
                  <c:Icon Glyph="{Binding MuteGlyph}" FontSize="{StaticResource IconMd}"
                          Foreground="{Binding ColorKey, Converter={x:Static vm:PlayerConverters.BrushByKey}}" />
                </Button>
                <TextBlock Classes="muted" FontSize="{StaticResource TextSm}" Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
              <c:MeterFader Grid.Column="1" Minimum="0" Maximum="1" ResetValue="1" Value="{Binding MixGain}" Level="{Binding MixLevel}"
                            MinDb="-70" MaxDb="0" WarnDb="-14" ClipDb="-7" VerticalAlignment="Center" IsEnabled="{Binding !Muted}" ToolTip.Tip="Mix knob" />
              <!-- Duet: the voice this player sings, under their name (lined up with it, past the screen and mic icons),
                   in their colour. Spans the row so a long singer name does not widen the name column. -->
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding VoiceText}" FontSize="{StaticResource TextXs}" FontWeight="{StaticResource WeightBold}"
                         Foreground="{Binding ColorKey, Converter={x:Static vm:PlayerConverters.BrushByKey}}" Margin="64,2,0,4"
                         IsVisible="{Binding VoiceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="muted" Text="{Binding MixGain, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </Border>
</UserControl>
