<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.SettingsPanelView"
             x:DataType="vm:SettingsPanelViewModel">

  <StackPanel Spacing="{StaticResource Space2}">
    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space3}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Light theme" />
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="Dark is easier on the eyes in a dim room" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding LightTheme}" OnContent="" OffContent="" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Show tooltips" />
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="Explanations when hovering buttons and settings" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTooltips}" OnContent="" OffContent="" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space2}">
        <TextBlock Text="Difficulty" />
        <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding Difficulty}" HorizontalAlignment="Stretch" />
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding DifficultyHint}" />
        <TextBlock Text="Note bar style" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding NoteBarStyles}" SelectedItem="{Binding NoteBarStyle}" HorizontalAlignment="Stretch" />
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="Background of the note bars on the beamer — White for dark videos, Black for bright ones" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Version, StringFormat='Ultrastar DJ v{0}'}" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
