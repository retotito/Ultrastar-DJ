<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.SettingsPanelView"
             x:DataType="vm:SettingsPanelViewModel">

  <StackPanel Spacing="{StaticResource Space2}">
    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space3}">
        <!-- Title, drop-down, description — like Difficulty and Note bar style. -->
        <StackPanel Spacing="{StaticResource Space2}">
          <TextBlock Text="Theme" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="Dark is easier on the eyes in a dim room" TextWrapping="Wrap" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Show tooltips" />
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="Explanations when hovering buttons and settings" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTooltips}" OnContent="" OffContent="" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space2}">
        <TextBlock Text="Difficulty" />
        <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding Difficulty}" HorizontalAlignment="Stretch"
                  IsEnabled="{Binding !DifficultyLocked}" ToolTip.ShowOnDisabled="True"
                  ToolTip.Tip="{Binding DifficultyLocked, Converter={x:Static vm:BoolConverters.Text}, ConverterParameter='Locked while a song runs — applies from the next song|How exactly the pitch must match'}" />
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding DifficultyHint}" />
        <TextBlock Text="Note bar style" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding NoteBarStyles}" SelectedItem="{Binding NoteBarStyle}" HorizontalAlignment="Stretch" />
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="Background of the note bars on the beamer — White for dark videos, Black for bright ones" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="Grid lines" />
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                       Text="Faint lines behind the notes, every two semitones — notes sit on a line or between two, like sheet music" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGridLines}" OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- YouTube songs need a current yt-dlp: YouTube changes often, yt-dlp follows within days. -->
    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space2}">
        <TextBlock Text="YouTube" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding YtDlpVersionText}" FontSize="{StaticResource TextSm}" />
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding YtDlpStatusText}" TextWrapping="Wrap"
                       IsVisible="{Binding YtDlpStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="tonal" Command="{Binding UpdateYtDlpCommand}" IsEnabled="{Binding YtDlpIdle}" VerticalAlignment="Center"
                  ToolTip.Tip="Downloads the newest yt-dlp from its official GitHub releases — used from the next YouTube song on">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="system_update_alt" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding YtDlpButtonText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                   Text="yt-dlp fetches every YouTube song. When YouTube changes something, songs fail until yt-dlp is updated — usually within days." />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space2}">
        <TextBlock Text="Logs &amp; data" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="tonal" Command="{Binding ShowLogFolderCommand}" ToolTip.Tip="Finder with today's log selected — the file to send when asking for help">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="folder_open" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" />
              <TextBlock Text="Log folder" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tonal" Command="{Binding OpenLogCommand}" ToolTip.Tip="Today's log in Console: search it and watch new lines arrive">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="description" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" />
              <TextBlock Text="Today's log" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tonal" Command="{Binding ShowCrashReportsCommand}" IsVisible="{Binding HasCrashReports}"
                  ToolTip.Tip="macOS wrote these when the app crashed; the newest is selected in Finder">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="bug_report" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CrashReportsText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tonal" Command="{Binding ShowDataFolderCommand}" ToolTip.Tip="Settings, song library and cache — for backups or a clean start">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="inventory_2" FontSize="{StaticResource IconMd}" VerticalAlignment="Center" />
              <TextBlock Text="App data" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                   Text="The log records what the app did (songs, playback, mics, errors) — one file per day, the last 7 are kept. Send it along when something went wrong." />
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding FilesStatus}"
                   IsVisible="{Binding FilesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="{StaticResource Space2}">
        <TextBlock Text="Backup" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="tonal" Command="{Binding BackUpCommand}" ToolTip.Tip="Save your settings and song marks as one zip — on a stick, a drive, a cloud folder">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="save" FontSize="{StaticResource IconMd}" />
              <TextBlock Text="Back up…" />
            </StackPanel>
          </Button>
          <Button Classes="tonal" Command="{Binding RestoreCommand}" ToolTip.Tip="Pick a backup zip: it replaces the current settings and marks at the next start">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="settings_backup_restore" FontSize="{StaticResource IconMd}" />
              <TextBlock Text="Restore…" />
            </StackPanel>
          </Button>
          <Button Classes="tonal stop" Command="{Binding QuitCommand}" IsVisible="{Binding RestorePending}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="power_settings_new" FontSize="{StaticResource IconMd}" />
              <TextBlock Text="Quit now" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                   Text="Settings, players and mics, outputs and latency, song sources, songbook, and your song marks (favourites, broken). Not included: the song list (a scan rebuilds it) and your USDB password (log in again after a restore)." />
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding BackupStatus}"
                   IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Version, StringFormat='Ultrastar DJ v{0}'}" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
