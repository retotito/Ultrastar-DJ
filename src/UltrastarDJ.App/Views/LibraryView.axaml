<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:core="using:UltrastarDJ.Core.Songs"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <!-- Song rows: zebra stripes (hover/selection still win: they style the template's presenter), and
         less vertical padding than Fluent's 9/12 → rows 43 instead of 53px. Fixed height keeps virtualization exact. -->
    <Style Selector="ListBox#SongList ListBoxItem">
      <Setter Property="Padding" Value="12,5,12,6" />
    </Style>
    <Style Selector="ListBox#SongList ListBoxItem:nth-child(2n)">
      <Setter Property="Background" Value="{DynamicResource BrushTableRowAlt}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="{StaticResource Pad3}"
            BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <!-- The clear X floats over the search box (same cell, drawn after it): visible whenever there is text — Fluent's
             own X shows only while the box has focus — and it cannot change the box's size. -->
        <Panel Grid.Column="0" Margin="0,0,16,0">
          <TextBox PlaceholderText="Search title or artist" Text="{Binding Search}" />
          <!-- Opaque in the box's own colour (Fluent's focused text box background): a long search runs under it, not through it. -->
          <Button Classes="sidebar" Width="26" Height="26" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Background="{DynamicResource TextControlBackgroundFocused}"
                  Command="{Binding ClearSearchCommand}" ToolTip.Tip="Clear the search"
                  IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <!-- Hover stays opaque: the usual 10 % tint would let the text under it show through. -->
            <Button.Styles>
              <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushSearchClearHover}" />
              </Style>
            </Button.Styles>
            <c:Icon Glyph="close" FontSize="{StaticResource IconSm}" />
          </Button>
        </Panel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Ratings}" c:FitWidestItem.IsEnabled="True" c:FitWidestItem.Suffix=" (88,888)" SelectedItem="{Binding Rating}" MinWidth="110" Margin="0,0,8,0" ToolTip.Tip="Popularity on USDB (★ 100–499, ★★ 500–999, ★★★ 1000–1999, ★★★★ 2000+ views) — hides local songs">
          <!-- Closed box: just the name; the counts are for choosing, in the open list. -->
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="vm:RatingOption">
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RatingOption">
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Label}" ConverterParameter="rating">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Opacity>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Opacity}" ConverterParameter="rating">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Opacity>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" c:FitWidestItem.IsEnabled="True" c:FitWidestItem.Suffix=" (88,888)" SelectedItem="{Binding Language}" MinWidth="120" Margin="0,0,8,0" ToolTip.Tip="Language">
          <!-- Closed box: just the name; the counts are for choosing, in the open list. -->
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Label}" ConverterParameter="language">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Opacity>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Opacity}" ConverterParameter="language">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Opacity>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="3" ItemsSource="{Binding Genres}" c:FitWidestItem.IsEnabled="True" c:FitWidestItem.Suffix=" (88,888)" SelectedItem="{Binding Genre}" MinWidth="120" Margin="0,0,8,0" ToolTip.Tip="Genre">
          <!-- Closed box: just the name; the counts are for choosing, in the open list. -->
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Label}" ConverterParameter="genre">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Opacity>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Opacity}" ConverterParameter="genre">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Opacity>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="4" ItemsSource="{Binding Sources}" c:FitWidestItem.IsEnabled="True" c:FitWidestItem.Suffix=" (88,888)" SelectedItem="{Binding Source}" MinWidth="140" ToolTip.Tip="Song source">
          <!-- Closed box: just the name; the counts are for choosing, in the open list. -->
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="vm:SourceOption">
              <TextBlock Text="{Binding}" Opacity="{Binding Opacity}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SourceOption">
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Label}" ConverterParameter="source">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Opacity>
                  <MultiBinding Converter="{x:Static vm:FacetConverters.Opacity}" ConverterParameter="source">
                    <Binding />
                    <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).Facets" />
                  </MultiBinding>
                </TextBlock.Opacity>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Always in place (nothing shifts when a filter is set); dimmed while there is nothing to clear. -->
        <Button Grid.Column="5" Classes="text" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"
                ToolTip.Tip="Clear the search and the filters (rating, language, genre, source)">
          <c:Icon Glyph="filter_list_off" FontSize="{StaticResource IconSm}" VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>

    <!-- Table: header + rows share the column definitions (LibraryTableLayout). Wider than the window → it scrolls
         horizontally (TableGrid width set in code-behind); the list keeps its own vertical scrolling. -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
      <Grid x:Name="TableGrid" RowDefinitions="Auto,*" HorizontalAlignment="Left">
        <!-- Header row: click to sort -->
        <Grid Grid.Row="0" Margin="16,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Table.TitleWidth}" MinWidth="{Binding Table.TitleMinWidth}" />
            <ColumnDefinition Width="{Binding Table.ArtistWidth}" MinWidth="{Binding Table.ArtistMinWidth}" />
            <ColumnDefinition Width="{Binding Table.YearWidth}" />
            <ColumnDefinition Width="{Binding Table.LanguageWidth}" />
            <ColumnDefinition Width="{Binding Table.GenreWidth}" />
            <ColumnDefinition Width="{Binding Table.EditionWidth}" />
            <ColumnDefinition Width="{Binding Table.CreatorWidth}" />
            <ColumnDefinition Width="{Binding Table.BpmWidth}" />
            <ColumnDefinition Width="{Binding Table.RatingWidth}" />
            <ColumnDefinition Width="{Binding Table.SourceWidth}" />
            <ColumnDefinition Width="{Binding Table.MediaWidth}" />
            <ColumnDefinition Width="{Binding Table.ActionsWidth}" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Title}"><TextBlock Classes="label" Text="{Binding TitleHeader}" /></Button>
          <Button Grid.Column="1" Classes="header" IsVisible="{Binding Table.ShowArtist}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Artist}"><TextBlock Classes="label" Text="{Binding ArtistHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="2" Classes="header" IsVisible="{Binding Table.ShowYear}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Year}"><TextBlock Classes="label" Text="{Binding YearHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="3" Classes="header" IsVisible="{Binding Table.ShowLanguage}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Language}"><TextBlock Classes="label" Text="{Binding LanguageHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="4" Classes="header" IsVisible="{Binding Table.ShowGenre}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Genre}"><TextBlock Classes="label" Text="{Binding GenreHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="5" Classes="header" IsVisible="{Binding Table.ShowEdition}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Edition}"><TextBlock Classes="label" Text="{Binding EditionHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="6" Classes="header" IsVisible="{Binding Table.ShowCreator}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Creator}"><TextBlock Classes="label" Text="{Binding CreatorHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="7" Classes="header" IsVisible="{Binding Table.ShowBpm}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Bpm}"><TextBlock Classes="label" Text="{Binding BpmHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="8" Classes="header" IsVisible="{Binding Table.ShowRating}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Rating}"><TextBlock Classes="label" Text="{Binding RatingHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <Button Grid.Column="9" Classes="header" IsVisible="{Binding Table.ShowSource}" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Source}"><TextBlock Classes="label" Text="{Binding SourceHeader}" TextTrimming="CharacterEllipsis" /></Button>
          <TextBlock Grid.Column="10" Classes="label" Text="MEDIA" IsVisible="{Binding Table.ShowMedia}" />
        </Grid>

        <ListBox Grid.Row="1" x:Name="SongList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 Background="Transparent" BorderThickness="0" Padding="4,0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryRow">
              <Grid Height="32" Background="Transparent" Opacity="{Binding Opacity}"
                    ToolTip.Tip="{Binding IsAvailable, Converter={x:Static vm:PlayerConverters.AvailabilityTooltip}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.TitleWidth}" MinWidth="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.TitleMinWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ArtistWidth}" MinWidth="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ArtistMinWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.YearWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.LanguageWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.GenreWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.EditionWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.CreatorWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.BpmWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.RatingWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.SourceWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.MediaWidth}" />
                  <ColumnDefinition Width="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ActionsWidth}" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Preview" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).PreviewCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding UnavailableTip}" ToolTip.ShowOnDisabled="True">
                      <MenuItem.Icon><c:Icon Glyph="play_arrow" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add to queue" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).AddToQueueCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding UnavailableTip}" ToolTip.ShowOnDisabled="True">
                      <MenuItem.Icon><c:Icon Glyph="queue_music" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Load into game" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).LoadIntoGameCommand}" CommandParameter="{Binding}"
                              ToolTip.ShowOnDisabled="True">
                    <ToolTip.Tip>
                      <MultiBinding Converter="{x:Static vm:PlayerConverters.FirstText}">
                        <Binding Path="UnavailableTip" />
                        <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).LoadSongTip" />
                      </MultiBinding>
                    </ToolTip.Tip>
                      <MenuItem.Icon><c:Icon Glyph="play_circle" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{Binding FavouriteMenuText}" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleFavouriteCommand}" CommandParameter="{Binding}">
                      <MenuItem.Icon><c:Icon Glyph="favorite" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding BrokenMenuText}" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleBrokenCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Bad notes or timing: still playable, but never offered on the songbook. Add a note in Details.">
                      <MenuItem.Icon><c:Icon Glyph="report" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Details" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ShowDetailsCommand}" CommandParameter="{Binding}">
                      <MenuItem.Icon><c:Icon Glyph="info" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Grid.ContextMenu>
                <!-- Before the title: ⚠ the last load failed for a reason of the song's own (LoadFailureService); the DJ's
                     marks (SongMarksService): broken (tooltip: the note) and favourite. -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*">
                  <c:Icon Glyph="warning" FontSize="{StaticResource IconMd}" Foreground="{DynamicResource BrushError}" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsVisible="{Binding HasFailure}" ToolTip.Tip="{Binding FailureTip}" Background="Transparent" />
                  <c:Icon Grid.Column="1" Glyph="report" FontSize="{StaticResource IconMd}" Foreground="{DynamicResource BrushError}" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsVisible="{Binding IsBroken}" ToolTip.Tip="{Binding BrokenTip}" Background="Transparent" />
                  <c:Icon Grid.Column="2" Glyph="favorite" FontSize="{StaticResource IconMd}" Foreground="{DynamicResource BrushFavourite}" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsVisible="{Binding IsFavourite}" ToolTip.Tip="Favourite" Background="Transparent" />
                  <TextBlock Grid.Column="3" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Artist}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowArtist}" />
                <TextBlock Grid.Column="2" Text="{Binding Year}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowYear}" />
                <TextBlock Grid.Column="3" Text="{Binding Language}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowLanguage}" />
                <TextBlock Grid.Column="4" Text="{Binding Genre}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowGenre}" />
                <TextBlock Grid.Column="5" Text="{Binding Edition}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowEdition}" />
                <TextBlock Grid.Column="6" Text="{Binding Creator}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowCreator}" />
                <TextBlock Grid.Column="7" Text="{Binding Bpm}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowBpm}" />
                <TextBlock Grid.Column="8" Text="{Binding Stars}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowRating}" />
                <Border Grid.Column="9" IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowSource}" Background="{DynamicResource BrushSecondaryContainer}" CornerRadius="{StaticResource RadiusFull}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Classes.usdb="{Binding IsUsdb}">
                  <Border.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource BrushOnSecondaryContainer}" />
                    </Style>
                    <Style Selector="Border.usdb">
                      <Setter Property="Background" Value="{DynamicResource BrushUsdb}" />
                    </Style>
                    <Style Selector="Border.usdb TextBlock">
                      <Setter Property="Foreground" Value="White" />
                    </Style>
                  </Border.Styles>
                  <TextBlock Text="{Binding Source}" FontSize="{StaticResource TextXs}" TextTrimming="CharacterEllipsis" MaxWidth="70" />
                </Border>
                <StackPanel Grid.Column="10" IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).Table.ShowMedia}" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <c:Icon Glyph="music_note" FontSize="{StaticResource IconSm}" IsVisible="{Binding HasLocalAudio}" ToolTip.Tip="Local audio" />
                  <c:Icon Glyph="movie" FontSize="{StaticResource IconSm}" IsVisible="{Binding HasLocalVideo}" ToolTip.Tip="Local video" />
                  <c:Icon Glyph="smart_display" FontSize="{StaticResource IconSm}" IsVisible="{Binding HasYouTube}" ToolTip.Tip="YouTube" />
                </StackPanel>
                <Button Grid.Column="11" Classes="sidebar" Width="28" Height="28" ToolTip.Tip="Actions">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="Preview" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).PreviewCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding UnavailableTip}" ToolTip.ShowOnDisabled="True">
                        <MenuItem.Icon><c:Icon Glyph="play_arrow" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Add to queue" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).AddToQueueCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding UnavailableTip}" ToolTip.ShowOnDisabled="True">
                        <MenuItem.Icon><c:Icon Glyph="queue_music" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Load into game" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).LoadIntoGameCommand}" CommandParameter="{Binding}"
                              ToolTip.ShowOnDisabled="True">
                    <ToolTip.Tip>
                      <MultiBinding Converter="{x:Static vm:PlayerConverters.FirstText}">
                        <Binding Path="UnavailableTip" />
                        <Binding Path="$parent[UserControl].((vm:LibraryViewModel)DataContext).LoadSongTip" />
                      </MultiBinding>
                    </ToolTip.Tip>
                        <MenuItem.Icon><c:Icon Glyph="play_circle" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="{Binding FavouriteMenuText}" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleFavouriteCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon><c:Icon Glyph="favorite" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{Binding BrokenMenuText}" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleBrokenCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Bad notes or timing: still playable, but never offered on the songbook. Add a note in Details.">
                        <MenuItem.Icon><c:Icon Glyph="report" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Details" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ShowDetailsCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon><c:Icon Glyph="info" FontSize="{StaticResource IconLg}" /></MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                  <c:Icon Glyph="more_vert" FontSize="{StaticResource IconMd}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </ScrollViewer>

    <!-- Footer: shown / total -->
    <Border Grid.Row="3" Padding="{StaticResource Pad2}"
            BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,1,0,0">
      <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Margin="4,0,0,0">
        <Run Text="{Binding ShownCount}" /><Run Text=" / " /><Run Text="{Binding TotalCount}" /><Run Text=" songs" />
      </TextBlock>
    </Border>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space2}"
                IsVisible="{Binding !TotalCount}">
      <c:Icon Glyph="library_music" FontSize="{StaticResource IconXl}" />
      <TextBlock Classes="muted" Text="No songs yet — add a folder under Song Sources" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
