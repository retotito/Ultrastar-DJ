<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:core="using:UltrastarDJ.Core.Songs"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <!-- Song rows: zebra stripes (hover/selection still win: they style the template's presenter), and
         less vertical padding than Fluent's 9/12 → rows 43 instead of 53px. Fixed height keeps virtualization exact. -->
    <Style Selector="ListBox#SongList ListBoxItem">
      <Setter Property="Padding" Value="12,5,12,6" />
    </Style>
    <Style Selector="ListBox#SongList ListBoxItem:nth-child(2n)">
      <Setter Property="Background" Value="{DynamicResource BrushTableRowAlt}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="{StaticResource Pad3}"
            BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <TextBox Grid.Column="0" Margin="0,0,16,0" Classes="clearButton" PlaceholderText="Search title or artist  —  double-click: preview · ⋮ or right-click: queue / game" Text="{Binding Search}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Ratings}" SelectedItem="{Binding Rating}" MinWidth="110" Margin="0,0,8,0" ToolTip.Tip="Popularity on USDB (★ 100–499, ★★ 500–999, ★★★ 1000–1999, ★★★★ 2000+ views) — hides local songs" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="120" Margin="0,0,8,0" ToolTip.Tip="Language" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding Genres}" SelectedItem="{Binding Genre}" MinWidth="120" Margin="0,0,8,0" ToolTip.Tip="Genre" />
        <ComboBox Grid.Column="4" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="140" ToolTip.Tip="Song source" />
        <Button Grid.Column="5" Classes="text" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasActiveFilters}" ToolTip.Tip="Reset rating, language, genre and source">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
            <c:Icon Glyph="filter_list_off" FontSize="{StaticResource IconSm}" VerticalAlignment="Center" />
            <TextBlock Text="Clear" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Header row: click to sort -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,2*,60,90,70,90,60,36" Margin="12,6">
      <Button Grid.Column="0" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Title}"><TextBlock Classes="label" Text="{Binding TitleHeader}" /></Button>
      <Button Grid.Column="1" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Artist}"><TextBlock Classes="label" Text="{Binding ArtistHeader}" /></Button>
      <Button Grid.Column="2" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Year}"><TextBlock Classes="label" Text="{Binding YearHeader}" /></Button>
      <Button Grid.Column="3" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Language}"><TextBlock Classes="label" Text="{Binding LanguageHeader}" /></Button>
      <Button Grid.Column="4" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Rating}"><TextBlock Classes="label" Text="{Binding RatingHeader}" /></Button>
      <Button Grid.Column="5" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:SongSort.Source}"><TextBlock Classes="label" Text="{Binding SourceHeader}" /></Button>
      <TextBlock Grid.Column="6" Classes="label" Text="MEDIA" />
    </Grid>

    <ListBox Grid.Row="2" x:Name="SongList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
             Background="Transparent" BorderThickness="0" Padding="4,0">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryRow">
          <Grid ColumnDefinitions="2*,2*,60,90,70,90,60,36" Height="32" Background="Transparent" Opacity="{Binding Opacity}"
                ToolTip.Tip="{Binding IsAvailable, Converter={x:Static vm:PlayerConverters.AvailabilityTooltip}}">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Preview" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).PreviewCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Add to queue" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).AddToQueueCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Load into game" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).LoadIntoGameCommand}" CommandParameter="{Binding}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Artist}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Year}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Language}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding Stars}" Classes="muted" VerticalAlignment="Center" />
            <Border Grid.Column="5" Background="{DynamicResource BrushSecondaryContainer}" CornerRadius="{StaticResource RadiusFull}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Classes.usdb="{Binding IsUsdb}">
              <Border.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource BrushOnSecondaryContainer}" />
                </Style>
                <Style Selector="Border.usdb">
                  <Setter Property="Background" Value="{DynamicResource BrushUsdb}" />
                </Style>
                <Style Selector="Border.usdb TextBlock">
                  <Setter Property="Foreground" Value="White" />
                </Style>
              </Border.Styles>
              <TextBlock Text="{Binding Source}" FontSize="{StaticResource TextXs}" TextTrimming="CharacterEllipsis" MaxWidth="70" />
            </Border>
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <c:Icon Glyph="music_note" FontSize="{StaticResource IconSm}" IsVisible="{Binding HasLocalAudio}" ToolTip.Tip="Local audio" />
              <c:Icon Glyph="movie" FontSize="{StaticResource IconSm}" IsVisible="{Binding HasLocalVideo}" ToolTip.Tip="Local video" />
              <c:Icon Glyph="smart_display" FontSize="{StaticResource IconSm}" IsVisible="{Binding HasYouTube}" ToolTip.Tip="YouTube" />
            </StackPanel>
            <Button Grid.Column="7" Classes="sidebar" Width="28" Height="28" ToolTip.Tip="Actions">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Preview" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).PreviewCommand}" CommandParameter="{Binding}" />
                  <MenuItem Header="Add to queue" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).AddToQueueCommand}" CommandParameter="{Binding}" />
                  <MenuItem Header="Load into game" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).LoadIntoGameCommand}" CommandParameter="{Binding}" />
                </MenuFlyout>
              </Button.Flyout>
              <c:Icon Glyph="more_vert" FontSize="{StaticResource IconMd}" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Footer: shown / total -->
    <Border Grid.Row="3" Padding="{StaticResource Pad2}"
            BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,1,0,0">
      <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Margin="4,0,0,0">
        <Run Text="{Binding ShownCount}" /><Run Text=" / " /><Run Text="{Binding TotalCount}" /><Run Text=" songs" />
      </TextBlock>
    </Border>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space2}"
                IsVisible="{Binding !TotalCount}">
      <c:Icon Glyph="library_music" FontSize="{StaticResource IconXl}" />
      <TextBlock Classes="muted" Text="No songs yet — add a folder under Song Sources" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
