<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             xmlns:audio="using:UltrastarDJ.Audio"
             x:Class="UltrastarDJ.App.Views.PlayersPanelView"
             x:DataType="vm:PlayersPanelViewModel">

  <UserControl.Resources>
    <x:String x:Key="GainGateTip">Gain knob · Gate knob (below)</x:String>
    <DataTemplate x:Key="PlayerCard" x:DataType="vm:PlayerCardViewModel">
      <Border Classes="card" Margin="0,0,0,8" Padding="12">
        <StackPanel Spacing="{StaticResource Space2}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="{StaticResource RadiusFull}" Margin="0,0,8,0"
                    Background="{Binding ColorKey, Converter={x:Static vm:PlayerConverters.BrushByKey}}" />
            <TextBox Grid.Column="1" Text="{Binding Name}" Classes="inline" />
            <!-- Detected note, or "gated" while the mic is below the gate: only meaningful while this mic is tested -->
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding NoteText}" VerticalAlignment="Center" MinWidth="110" TextAlignment="Right"
                       IsVisible="{Binding Testing}" ToolTip.Tip="Detected note. 'gated' = below the GATE threshold, treated as silence (no notes, no points)" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding MicOptions}"
                      SelectedItem="{Binding SelectedMic}" HorizontalAlignment="Stretch">
              <!-- Inputs another player already sings on can't be picked (the entry says who). -->
              <ComboBox.Styles>
                <Style Selector="ComboBoxItem" x:DataType="vm:MicOption">
                  <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                </Style>
              </ComboBox.Styles>
            </ComboBox>
            <Button Grid.Column="1" Classes="tonal" Margin="8,0,0,0" Padding="12,4" Command="{Binding ToggleTestCommand}"
                    IsEnabled="{Binding HasMic}" Classes.go="{Binding !Testing}" Classes.stop="{Binding Testing}" ToolTip.Tip="Open this mic: live meter and note">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:Icon Glyph="{Binding Testing, Converter={x:Static vm:PlayerConverters.TestGlyph}}" FontSize="{StaticResource IconSm}" />
                <TextBlock Text="{Binding Testing, Converter={x:Static vm:BoolConverters.Text}, ConverterParameter='Stop|Test'}"
                           FontSize="{StaticResource TextSm}" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Two faders with their meter as the track (Tauri PlayerCard), on the mic scale −70…0 dB:
               GAIN + GATE in one — meter = the mic after gain, shaded below the gate, gate handle under the track;
               MIX — meter = what the speakers get (gated signal × mix). -->
          <Grid ColumnDefinitions="52,*,60" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space1}">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="GAIN" VerticalAlignment="Top" Margin="0,9,0,0"
                       ToolTip.Tip="{StaticResource GainGateTip}" />
            <c:MeterFader Grid.Row="0" Grid.Column="1" Minimum="-40" Maximum="20" ResetValue="0" Value="{Binding InputGainDb}" Level="{Binding Level}"
                          MinDb="-70" MaxDb="0" WarnDb="-12" ClipDb="-6"
                          ShowGate="True" GateDb="{Binding GateDb}" GateMinDb="-70" GateMaxDb="-20" GateResetDb="-50"
                          ToolTip.Tip="{StaticResource GainGateTip}" />
            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Top">
              <TextBlock Classes="muted" Text="{Binding GainText}" TextAlignment="Right" Margin="0,5,0,0" />
              <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding GateText}" TextAlignment="Right" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="MIX" VerticalAlignment="Center"
                       ToolTip.Tip="Mix knob" />
            <c:MeterFader Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" ResetValue="1" Value="{Binding MixGain}" Level="{Binding MixLevel}"
                          MinDb="-70" MaxDb="0" WarnDb="-12" ClipDb="-6"
                          ToolTip.Tip="Mix knob" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="{Binding MixGain, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" VerticalAlignment="Center"
                       Text="{Binding MicDelayText, StringFormat='Mic delay {0}'}" ToolTip.Tip="How much later this mic's notes reach the scorer than the singer sings them (mic, USB and pitch analysis). Scoring matches each heard pitch with the note this many ms earlier. Set it with Calibrate; until then 140 ms is assumed." />
            <Button Grid.Column="1" Classes="tonal" Command="{Binding CalibrateCommand}" IsEnabled="{Binding !Calibrating}" Padding="12,4"
                    ToolTip.Tip="Measures this mic's delay: plays 5 tones on the game speakers and listens for them through the same pitch analysis as the game. Hold the mic in front of the speakers in a quiet moment. Set the speakers' latency (Audio Output → Test sync) first; it is subtracted from the result.">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:Icon Glyph="timer" FontSize="{StaticResource IconSm}" />
                <TextBlock Text="Calibrate" FontSize="{StaticResource TextSm}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="{StaticResource Space2}">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space1}">
      <Button Classes="sidebar" Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Refresh device list (stop the mic tests first; plugging in is detected by itself)">
        <c:Icon Glyph="refresh" FontSize="{StaticResource IconMd}" />
      </Button>
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Testing}">
      <TextBlock Grid.Column="0" Classes="label" Text="MONITOR" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding MonitorOutput}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="audio:AudioDeviceInfo">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ToggleButton Grid.Column="2" IsChecked="{Binding Monitoring}" Margin="8,0,0,0" ToolTip.Tip="Hear the mics on this output">
        <c:Icon Glyph="hearing" FontSize="{StaticResource IconMd}" />
      </ToggleButton>
    </Grid>

    <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlayerCard}" />

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
