<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             xmlns:svc="using:UltrastarDJ.App.Services"
             x:Class="UltrastarDJ.App.Views.AudioOutputPanelView"
             x:DataType="vm:AudioOutputPanelViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="ChannelCard" x:DataType="vm:OutputChannelViewModel">
      <Border Classes="card" Margin="0,0,0,8">
        <StackPanel Spacing="{StaticResource Space2}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Glyph="{Binding Glyph}" Margin="0,0,8,0" />
            <StackPanel Grid.Column="1">
              <TextBlock Classes="title" Text="{Binding Title}" />
              <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Subtitle}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding StateText}" VerticalAlignment="Center" />
          </Grid>

          <TextBlock Classes="label" Text="OUTPUT DEVICE" />
          <ComboBox ItemsSource="{Binding Options}"
                    SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:OutputOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Classes="label" Text="VOLUME" />
          <Grid ColumnDefinitions="*,44">
            <c:Fader Minimum="0" Maximum="1" Value="{Binding Gain}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Gain, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" TextAlignment="Right" />
          </Grid>
          <c:LevelMeter Height="6" Level="{Binding Level}" Fill="{DynamicResource BrushPrimary}" Track="{DynamicResource BrushSurfaceContainerHighest}" />

          <!-- Game only: how much later the audience hears this output; lyrics, notes and scoring follow it. -->
          <Panel IsVisible="{Binding Latency, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="{StaticResource Space2}" DataContext="{Binding Latency}" x:DataType="vm:GameSyncViewModel">
              <TextBlock Classes="label" Text="LATENCY" Margin="0,4,0,0"
                         ToolTip.Tip="How much later the speakers play than the app sends the sound (cable ~15 ms, TV/HDMI 50–150 ms, Bluetooth 150–300 ms). Lyrics and notes are shown this much later. Saved per output device." />
              <Grid ColumnDefinitions="*,60">
                <c:Fader Minimum="{Binding MinLatencyMs}" Maximum="{Binding MaxLatencyMs}" ResetValue="0" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding LatencyMs}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding LatencyMs, StringFormat='{}{0:F0} ms'}" VerticalAlignment="Center" TextAlignment="Right" />
              </Grid>
              <Button Classes="tonal" Classes.go="{Binding !IsRunning}" Classes.stop="{Binding IsRunning}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" HorizontalAlignment="Left" Padding="12,4"
                      ToolTip.Tip="{Binding ToggleTip}" ToolTip.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <c:Icon Glyph="graphic_eq" FontSize="{StaticResource IconSm}" />
                  <TextBlock Text="Test sync" FontSize="{StaticResource TextSm}" IsVisible="{Binding !IsRunning}" />
                  <TextBlock Text="Stop test" FontSize="{StaticResource TextSm}" IsVisible="{Binding IsRunning}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Panel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="{StaticResource Space2}">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space1}">
      <Button Classes="sidebar" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh device list — connect USB or Bluetooth first">
        <c:Icon Glyph="refresh" FontSize="{StaticResource IconMd}" />
      </Button>
    </StackPanel>

    <ContentControl Content="{Binding Game}" ContentTemplate="{StaticResource ChannelCard}" />
    <ContentControl Content="{Binding Preview}" ContentTemplate="{StaticResource ChannelCard}" />

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
               Text="Multichannel interfaces are listed once per stereo pair. Mic monitoring follows the game output. Set the game latency before calibrating the mics." />
  </StackPanel>
</UserControl>
