<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.MediaLabPanelView"
             x:DataType="vm:MediaLabPanelViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="ChannelCard" x:DataType="vm:ChannelLabViewModel">
      <Border Classes="card" Margin="0,0,0,8">
        <StackPanel Spacing="{StaticResource Space2}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="{Binding Title}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
          </Grid>

          <TextBox Text="{Binding Input}" PlaceholderText="YouTube id / URL or video file path" />
          <TextBox Text="{Binding AudioPath}" PlaceholderText="Optional #MP3 path (then the input above is the muted visual)" />

          <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MediaLabPanelViewModel)DataContext).Devices}"
                    SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
            <Button Classes="tonal" Command="{Binding LoadCommand}" Content="Load" IsEnabled="{Binding !Busy}" />
            <Button Classes="sidebar" Command="{Binding SeekBackCommand}" ToolTip.Tip="-10 s"><c:Icon Glyph="replay_10" /></Button>
            <Button Classes="sidebar" Command="{Binding PlayCommand}" ToolTip.Tip="Play"><c:Icon Glyph="play_arrow" /></Button>
            <Button Classes="sidebar" Command="{Binding PauseCommand}" ToolTip.Tip="Pause"><c:Icon Glyph="pause" /></Button>
            <Button Classes="sidebar" Command="{Binding SeekForwardCommand}" ToolTip.Tip="+10 s"><c:Icon Glyph="forward_10" /></Button>
            <Button Classes="sidebar" Command="{Binding UnloadCommand}" ToolTip.Tip="Unload"><c:Icon Glyph="stop" /></Button>
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Glyph="volume_up" FontSize="{StaticResource IconMd}" Margin="0,0,8,0" />
            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Gain}" />
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Position}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>

          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Level}" Height="6" />

          <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Drift}" />
          <TextBlock Foreground="{DynamicResource BrushError}" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                     Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Border Background="{DynamicResource BrushBeamerBackground}" CornerRadius="{StaticResource RadiusMd}" Height="150" ClipToBounds="True">
            <c:VideoSurface Source="{Binding Frames}" />
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="{StaticResource Space2}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <c:Icon Grid.Column="0" Glyph="science" Margin="0,0,8,0" />
      <TextBlock Grid.Column="1" Classes="title" Text="Media Lab (Sprint 1 spike)" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="sidebar" Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Refresh audio devices">
        <c:Icon Glyph="refresh" FontSize="{StaticResource IconMd}" />
      </Button>
    </Grid>

    <ContentControl Content="{Binding Game}" ContentTemplate="{StaticResource ChannelCard}" />
    <ContentControl Content="{Binding Preview}" ContentTemplate="{StaticResource ChannelCard}" />

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
               Text="Game video is mirrored to every open beamer. Open one in Displays to verify." />
  </StackPanel>
</UserControl>
