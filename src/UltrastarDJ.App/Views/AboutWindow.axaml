<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:UltrastarDJ.App.Localization"
        x:Class="UltrastarDJ.App.Views.AboutWindow"
        Title="{l:T about.title}"
        Icon="avares://UltrastarDJ/Assets/icon.png"
        Background="{DynamicResource BrushSurfaceContainerLow}"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="32" Spacing="8" HorizontalAlignment="Center">
    <Image Source="avares://UltrastarDJ/Assets/icon.png" Width="96" Height="96" Margin="0,0,0,8" />
    <TextBlock Classes="title" Text="Ultrastar DJ" FontSize="{StaticResource TextXl}" HorizontalAlignment="Center" />
    <SelectableTextBlock x:Name="VersionText" Foreground="{DynamicResource BrushOnSurfaceVariant}" HorizontalAlignment="Center" />
    <Button Classes="text" x:Name="Website" Content="{l:T about.website}" HorizontalAlignment="Center" Margin="0,8,0,0" />
  </StackPanel>
</Window>
