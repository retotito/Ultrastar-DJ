<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:UltrastarDJ.App.Localization"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.SongDetailsView"
             x:DataType="vm:SongDetailsViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="FieldRow" x:DataType="vm:DetailField">
      <!-- The label column takes the widest label of its card (at least 120): longer languages must not run into the values. -->
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="FieldLabel" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="muted" Text="{Binding Label}" FontSize="{StaticResource TextSm}" Margin="0,0,12,0" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource TextSm}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- 860 + 16: room between the scrolling content and Fluent's floating scrollbar (as in the sidebar popovers).
       Wider when the footer's buttons need it (longer languages) — set in code-behind, never wider than the window. -->
  <Border x:Name="Card" Classes="card floating" Width="876" Padding="{StaticResource Pad6}">
    <DockPanel>
      <!-- Header: picture, title, artist, source; close -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
        <Border Width="96" Height="96" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                Background="{DynamicResource BrushSurfaceContainerHighest}">
          <Panel>
            <c:Icon Glyph="music_note" FontSize="{StaticResource IconXl}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding Picture, Converter={x:Static ObjectConverters.IsNull}}" />
            <Image Source="{Binding Picture}" Stretch="UniformToFill" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="{StaticResource Space1}">
          <SelectableTextBlock Text="{Binding Title}" FontSize="{StaticResource Text2Xl}" FontWeight="{StaticResource WeightBold}" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding Artist}" Classes="muted" FontSize="{StaticResource TextLg}" TextWrapping="Wrap" />
          <!-- Source, then the DJ's marks: favourite, broken (with a note below). -->
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="0,4,0,0">
            <Border Background="{DynamicResource BrushSecondaryContainer}" CornerRadius="{StaticResource RadiusFull}" Padding="8,2"
                    VerticalAlignment="Center" Classes.usdb="{Binding IsUsdb}">
              <Border.Styles>
                <Style Selector="Border.usdb">
                  <Setter Property="Background" Value="{DynamicResource BrushUsdb}" />
                </Style>
              </Border.Styles>
              <TextBlock Text="{Binding Source}" FontSize="{StaticResource TextXs}" Foreground="{DynamicResource BrushOnSecondaryContainer}" />
            </Border>
            <ToggleButton IsChecked="{Binding IsFavourite}" Padding="10,2" CornerRadius="{StaticResource RadiusFull}" VerticalAlignment="Center"
                          ToolTip.Tip="{l:T details.favourite_find_rating_filter}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:Icon Glyph="favorite" FontSize="{StaticResource IconSm}" Foreground="{DynamicResource BrushFavourite}" />
                <TextBlock Text="{l:T details.favourite}" FontSize="{StaticResource TextXs}" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsBroken}" Padding="10,2" CornerRadius="{StaticResource RadiusFull}" VerticalAlignment="Center"
                          ToolTip.Tip="{l:T details.broken_bad_notes_timing}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:Icon Glyph="report" FontSize="{StaticResource IconSm}" Foreground="{DynamicResource BrushError}" />
                <TextBlock Text="{l:T details.broken}" FontSize="{StaticResource TextXs}" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
          <TextBox Text="{Binding Note}" IsVisible="{Binding ShowNote}" PlaceholderText="{l:T details.what_wrong_e_g}"
                   FontSize="{StaticResource TextSm}" Margin="0,4,0,0" MaxWidth="520" HorizontalAlignment="Left" />
        </StackPanel>
        <Button Grid.Column="2" Classes="sidebar" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip.Tip="{l:T details.close_esc}">
          <c:Icon Glyph="close" FontSize="{StaticResource IconLg}" />
        </Button>
      </Grid>

      <!-- Footer: open elsewhere (left), song actions (right) -->
      <Grid x:Name="Footer" DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="0,0,16,0">
          <Button Classes="text" Click="OnShowInFolder" IsVisible="{Binding Folder, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{l:T details.show_song_s_txt}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="folder_open" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T details.show_finder}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="text" Click="OnOpenUsdb" IsVisible="{Binding IsUsdb}" ToolTip.Tip="{l:T details.open_song_s_page}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="open_in_new" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T details.open_usdb}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="text" Click="OnOpenYouTube" IsVisible="{Binding HasYouTube}" ToolTip.Tip="{l:T details.open_song_s_video}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="smart_display" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T details.open_youtube}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Button Classes="text" Command="{Binding PreviewCommand}" ToolTip.Tip="{Binding UnavailableTip}" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="play_arrow" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T details.preview}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="text" Command="{Binding AddToQueueCommand}" ToolTip.Tip="{Binding UnavailableTip}" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="queue_music" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T details.add_queue}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tonal" Command="{Binding LoadIntoGameCommand}" ToolTip.Tip="{Binding LoadTip}" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="play_circle" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
              <TextBlock Text="{l:T details.load_into_game}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource Space3}" Margin="0,0,16,0">
          <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Grid ColumnDefinitions="*,16,*">
            <Border Classes="card">
              <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="label" Text="{l:T details.song}" />
                <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" Grid.IsSharedSizeScope="True" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="label" Text="{l:T details.notes}" />
                <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource FieldRow}" Grid.IsSharedSizeScope="True" />
                <TextBlock Classes="muted" Text="{l:T details.loading}" FontSize="{StaticResource TextSm}" IsVisible="{Binding Loading}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card" IsVisible="{Binding HasFiles}">
            <StackPanel Spacing="{StaticResource Space2}">
              <TextBlock Classes="label" Text="{l:T details.files}" />
              <SelectableTextBlock Classes="muted" Text="{Binding Folder}" FontSize="{StaticResource TextXs}" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetailFile">
                    <Grid ColumnDefinitions="30,96,*" Margin="0,2" ToolTip.Tip="{Binding Path}">
                      <c:Icon Glyph="{Binding Glyph}" FontSize="{StaticResource IconLg}" Classes.missing="{Binding !Exists}" VerticalAlignment="Center">
                        <c:Icon.Styles>
                          <Style Selector="c|Icon">
                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                          </Style>
                          <Style Selector="c|Icon.missing">
                            <Setter Property="Foreground" Value="{DynamicResource BrushError}" />
                          </Style>
                        </c:Icon.Styles>
                      </c:Icon>
                      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Label}" FontSize="{StaticResource TextSm}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{StaticResource TextSm}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasProblems}">
            <StackPanel Spacing="{StaticResource Space2}">
              <TextBlock Classes="label" Text="{l:T details.problems}" />
              <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="30,*" Margin="0,2">
                      <c:Icon Glyph="warning" FontSize="{StaticResource IconLg}" Foreground="{DynamicResource BrushError}" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding}" FontSize="{StaticResource TextSm}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding NoProblems}" Margin="4,0">
            <c:Icon Glyph="check_circle" FontSize="{StaticResource IconLg}" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:T details.no_problems_found_song}" FontSize="{StaticResource TextSm}" VerticalAlignment="Center" />
          </StackPanel>

          <Border Classes="card" IsVisible="{Binding HasTxt}">
            <StackPanel Spacing="{StaticResource Space2}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="{l:T details.txt_file}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="text" Click="OnCopyTxt" ToolTip.Tip="{l:T details.copy_whole_song_text}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                    <c:Icon Glyph="content_copy" FontSize="{StaticResource IconLg}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T details.copy}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <Border Background="{DynamicResource BrushSurfaceContainerLowest}" CornerRadius="{StaticResource RadiusMd}" Padding="{StaticResource Pad2}">
                <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Txt}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextXs}" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
