<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:UltrastarDJ.App.Localization"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.SourcesPanelView"
             x:DataType="vm:SourcesPanelViewModel">

  <StackPanel Spacing="{StaticResource Space2}">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space1}">
      <Button Classes="tonal" Command="{Binding AddFolderCommand}" IsEnabled="{Binding !Busy}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
          <c:Icon Glyph="create_new_folder" FontSize="{StaticResource IconMd}" />
          <TextBlock Text="{l:T sources.add_folder}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Sources}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SourceRowViewModel">
          <Border Classes="card" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
              <ToggleSwitch Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsChecked="{Binding Enabled}" OnContent="" OffContent="" VerticalAlignment="Center"
                            Margin="0,0,8,0" ToolTip.Tip="{l:T sources.off_folder_s_songs}" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}" Opacity="{Binding Opacity}">
                <TextBlock Classes="title" Text="{Binding Label}" VerticalAlignment="Center" />
                <c:Icon Glyph="usb_off" FontSize="{StaticResource IconMd}" Foreground="{DynamicResource BrushError}" VerticalAlignment="Center"
                        IsVisible="{Binding IsMissing}" ToolTip.Tip="{l:T sources.folder_not_found_drive}" />
              </StackPanel>
              <Button Grid.Row="0" Grid.Column="2" Classes="sidebar" Command="{Binding RescanCommand}" ToolTip.Tip="{l:T sources.rescan}" IsEnabled="{Binding !IsMissing}">
                <c:Icon Glyph="refresh" FontSize="{StaticResource IconMd}" />
              </Button>
              <Button Grid.Row="0" Grid.Column="3" Classes="sidebar" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T sources.remove_source}">
                <c:Icon Glyph="delete" FontSize="{StaticResource IconMd}" />
              </Button>
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Opacity="{Binding Opacity}">
                <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding CountText}" Margin="8,0,0,0" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
               Text="{l:T sources.folders_are_scanned_recursively}"
               IsVisible="{Binding !Sources.Count}" />

    <!-- USDB -->
    <Border Classes="card" Margin="0,8,0,0">
      <StackPanel Spacing="{StaticResource Space2}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <ToggleSwitch IsChecked="{Binding UsdbEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" Margin="0,0,8,0"
                        ToolTip.Tip="{l:T sources.off_usdb_songs_are}" />
          <c:Icon Grid.Column="1" Glyph="cloud" Margin="0,0,8,0" Foreground="{DynamicResource BrushUsdb}" />
          <TextBlock Grid.Column="2" Classes="title" Text="USDB" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Classes="muted" FontSize="{StaticResource TextXs}" VerticalAlignment="Center"
                     Text="{l:Format UsdbCount, sources.usdb_count}" IsVisible="{Binding UsdbCount}" />
        </Grid>
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                   Text="{l:T sources.usdb_animux_de_27}" />

        <!-- Login form -->
        <StackPanel Spacing="{StaticResource Space1}" IsVisible="{Binding !UsdbConnected}">
          <TextBox PlaceholderText="{l:T sources.username}" Text="{Binding UsdbUser}" IsEnabled="{Binding !UsdbBusy}" />
          <TextBox PlaceholderText="{l:T sources.password}" PasswordChar="•" Text="{Binding UsdbPassword}" IsEnabled="{Binding !UsdbBusy}" />
          <Button Classes="tonal" HorizontalAlignment="Right" Command="{Binding UsdbConnectCommand}" Content="{l:T sources.connect}" />
        </StackPanel>

        <!-- Connected -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" IsVisible="{Binding UsdbConnected}">
          <Button Classes="tonal go" Command="{Binding UsdbSyncCommand}" ToolTip.Tip="{l:T sources.fetch_songs_added_changed}" IsVisible="{Binding !UsdbSyncing}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:Icon Glyph="sync" FontSize="{StaticResource IconMd}" />
              <TextBlock Text="{l:T sources.sync}" />
            </StackPanel>
          </Button>
          <Button Classes="sidebar" Command="{Binding UsdbFullSyncCommand}" ToolTip.Tip="{l:T sources.download_whole_catalog_again}" IsVisible="{Binding !UsdbSyncing}">
            <c:Icon Glyph="cloud_download" FontSize="{StaticResource IconMd}" />
          </Button>
          <Button Classes="tonal stop" Command="{Binding UsdbAbortCommand}" Content="{l:T sources.stop_sync}" IsVisible="{Binding UsdbSyncing}" />
          <Button Classes="sidebar" Command="{Binding UsdbDisconnectCommand}" ToolTip.Tip="{l:T sources.disconnect_remove_usdb_songs}" IsEnabled="{Binding !UsdbSyncing}">
            <c:Icon Glyph="logout" FontSize="{StaticResource IconMd}" />
          </Button>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding UsdbSyncing}" />

        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding UsdbStatus}"
                   IsVisible="{Binding UsdbStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Song texts kept on this computer: songs stay singable if USDB is down or gone. -->
        <StackPanel Spacing="{StaticResource Space1}" IsVisible="{Binding UsdbConnected}" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="{l:T sources.keep_song_texts_computer}" />
          <RadioButton GroupName="UsdbTexts" IsChecked="{Binding TextsLoaded}" Content="{l:T sources.only_songs_i_load}"
                       ToolTip.Tip="{l:T sources.each_song_s_text}" />
          <RadioButton GroupName="UsdbTexts" IsChecked="{Binding TextsFavourites}" Content="{l:T sources.also_all_favourites}"
                       ToolTip.Tip="{l:T sources.downloads_texts_your_favourite}" />
          <RadioButton GroupName="UsdbTexts" IsChecked="{Binding TextsAll}"
                       ToolTip.Tip="{l:T sources.downloads_every_song_text}">
            <StackPanel>
              <TextBlock Text="{l:T sources.all_usdb_songs}" />
              <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{l:T sources.200_mb_about_12}" />
            </StackPanel>
          </RadioButton>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding TextsProgress}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="sidebar" Command="{Binding ToggleTextsPausedCommand}" IsVisible="{Binding TextsCanPause}"
                    ToolTip.Tip="{l:Pick TextsPaused, True=sources.resume_download, False=sources.pause_download}">
              <c:Icon Glyph="{Binding TextsPaused, Converter={x:Static vm:BoolConverters.Glyph}, ConverterParameter='play_arrow|pause'}" FontSize="{StaticResource IconMd}" />
            </Button>
          </Grid>
          <!-- Where they are: readable "Artist - Title [id].txt" files, usable by other karaoke programs too. -->
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding TextsFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding TextsFolder}" />
            <Button Grid.Column="1" Classes="sidebar" Command="{Binding ShowTextsFolderCommand}" ToolTip.Tip="{l:T sources.show_finder}">
              <c:Icon Glyph="folder_open" FontSize="{StaticResource IconMd}" />
            </Button>
            <Button Grid.Column="2" Classes="sidebar" Command="{Binding ChangeTextsFolderCommand}" IsEnabled="{Binding !TextsMoving}"
                    ToolTip.Tip="{l:T sources.choose_another_folder_song}">
              <c:Icon Glyph="drive_file_move" FontSize="{StaticResource IconMd}" />
            </Button>
            <Button Grid.Column="3" Classes="sidebar" Command="{Binding DefaultTextsFolderCommand}" IsVisible="{Binding TextsCustomFolder}" IsEnabled="{Binding !TextsMoving}"
                    ToolTip.Tip="{l:T sources.back_app_s_own}">
              <c:Icon Glyph="settings_backup_restore" FontSize="{StaticResource IconMd}" />
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
