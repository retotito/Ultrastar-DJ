<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.SourcesPanelView"
             x:DataType="vm:SourcesPanelViewModel">

  <StackPanel Spacing="{StaticResource Space2}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <c:Icon Grid.Column="0" Glyph="library_music" Margin="0,0,8,0" />
      <TextBlock Grid.Column="1" Classes="title" Text="Song Sources" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="tonal" Command="{Binding AddFolderCommand}" IsEnabled="{Binding !Busy}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
          <c:Icon Glyph="create_new_folder" FontSize="{StaticResource IconMd}" Foreground="{DynamicResource BrushOnSecondaryContainer}" />
          <TextBlock Text="Add folder" Foreground="{DynamicResource BrushOnSecondaryContainer}" />
        </StackPanel>
      </Button>
    </Grid>

    <ItemsControl ItemsSource="{Binding Sources}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SourceRowViewModel">
          <Border Classes="card" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="title" Text="{Binding Label}" />
              <Button Grid.Row="0" Grid.Column="1" Classes="sidebar" Command="{Binding RescanCommand}" ToolTip.Tip="Rescan">
                <c:Icon Glyph="refresh" FontSize="{StaticResource IconMd}" />
              </Button>
              <Button Grid.Row="0" Grid.Column="2" Classes="sidebar" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove source">
                <c:Icon Glyph="delete" FontSize="{StaticResource IconMd}" />
              </Button>
              <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Classes="muted" FontSize="{StaticResource TextXs}"
                         Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
               Text="Folders are scanned recursively for UltraStar .txt files."
               IsVisible="{Binding !Sources.Count}" />

    <!-- USDB -->
    <Border Classes="card" Margin="0,8,0,0">
      <StackPanel Spacing="{StaticResource Space2}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:Icon Glyph="cloud" Margin="0,0,8,0" Foreground="{DynamicResource BrushUsdb}" />
          <TextBlock Grid.Column="1" Classes="title" Text="USDB" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="muted" FontSize="{StaticResource TextXs}" VerticalAlignment="Center"
                     Text="{Binding UsdbCount, StringFormat='{}{0:N0} songs'}" IsVisible="{Binding UsdbCount}" />
        </Grid>
        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
                   Text="usdb.animux.de — 27 000 community songs played from YouTube. Needs a free account and internet." />

        <!-- Login form -->
        <StackPanel Spacing="{StaticResource Space1}" IsVisible="{Binding !UsdbConnected}">
          <TextBox PlaceholderText="Username" Text="{Binding UsdbUser}" IsEnabled="{Binding !UsdbBusy}" />
          <TextBox PlaceholderText="Password" PasswordChar="•" Text="{Binding UsdbPassword}" IsEnabled="{Binding !UsdbBusy}" />
          <Button Classes="tonal" HorizontalAlignment="Right" Command="{Binding UsdbConnectCommand}" Content="Connect" />
        </StackPanel>

        <!-- Connected -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" IsVisible="{Binding UsdbConnected}">
          <Button Classes="tonal" Command="{Binding UsdbSyncCommand}" ToolTip.Tip="Fetch songs added or changed since the last sync" IsVisible="{Binding !UsdbSyncing}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:Icon Glyph="sync" FontSize="{StaticResource IconMd}" Foreground="{DynamicResource BrushOnSecondaryContainer}" />
              <TextBlock Text="Sync" Foreground="{DynamicResource BrushOnSecondaryContainer}" />
            </StackPanel>
          </Button>
          <Button Classes="sidebar" Command="{Binding UsdbFullSyncCommand}" ToolTip.Tip="Download the whole catalog again" IsVisible="{Binding !UsdbSyncing}">
            <c:Icon Glyph="cloud_download" FontSize="{StaticResource IconMd}" />
          </Button>
          <Button Classes="tonal" Command="{Binding UsdbAbortCommand}" Content="Stop sync" IsVisible="{Binding UsdbSyncing}" />
          <Button Classes="sidebar" Command="{Binding UsdbDisconnectCommand}" ToolTip.Tip="Disconnect and remove USDB songs from the library" IsEnabled="{Binding !UsdbSyncing}">
            <c:Icon Glyph="logout" FontSize="{StaticResource IconMd}" />
          </Button>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding UsdbSyncing}" />

        <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Text="{Binding UsdbStatus}"
                   IsVisible="{Binding UsdbStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
