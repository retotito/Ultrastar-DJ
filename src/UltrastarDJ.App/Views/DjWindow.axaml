<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:UltrastarDJ.App.Localization"
        xmlns:vm="using:UltrastarDJ.App.ViewModels"
        xmlns:c="using:UltrastarDJ.App.Controls"
        xmlns:svc="using:UltrastarDJ.App.Services"
        xmlns:v="using:UltrastarDJ.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="UltrastarDJ.App.Views.DjWindow"
        x:DataType="vm:DjWindowViewModel"
        Title="Ultrastar DJ"
        Width="1420" Height="860"
        MinWidth="1100" MinHeight="700"
        Icon="avares://UltrastarDJ/Assets/icon.png"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource BrushBackground}">

  <Window.Styles>
    <!-- Windows: Avalonia draws a title bar over the top row (the caption buttons right, the window title left —
         over the search field). The title is left out of it; the taskbar still names the window. macOS draws its own
         buttons and no title here. -->
    <Style Selector="chrome|WindowDrawnDecorations TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>

  <Panel>
  <Grid ColumnDefinitions="Auto,*,Auto">

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <!-- Its grey starts below the top row: the corner with the macOS buttons belongs to the row (no divider under the
         buttons), and the row's bottom line runs on across it. Transparent, not empty, so the corner drags the window. -->
    <Border Grid.Column="0" x:Name="Sidebar"
            Width="{StaticResource SidebarWidth}"
            Background="Transparent">
      <Border.Styles>
        <Style Selector="Button.sidebar c|Icon">
          <Setter Property="FontSize" Value="{StaticResource IconNav}" />
        </Style>
        <!-- Game Displays while single-screen mode is in effect (the panel's badge has the same orange). -->
        <Style Selector="Button.sidebar c|Icon.single">
          <Setter Property="Foreground" Value="{DynamicResource BrushSingleScreen}" />
        </Style>
      </Border.Styles>
      <Panel>
      <Border Margin="{StaticResource SidebarBodyMargin}"
              Background="{DynamicResource BrushSurfaceContainerLow}"
              BorderBrush="{DynamicResource BrushOutlineVariant}"
              BorderThickness="0,1,1,0" />
      <!-- The app icon in the top corner where a title bar would name the app — not on macOS, whose window buttons sit
           here. Transparent to the mouse: the corner still drags the window. -->
      <Border Height="{StaticResource TopBarHeight}" VerticalAlignment="Top" IsHitTestVisible="False"
              IsVisible="{OnPlatform Default=True, macOS=False}">
        <Image Source="avares://UltrastarDJ/Assets/icon.png" Width="{StaticResource IconXl}" Height="{StaticResource IconXl}"
               RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <DockPanel Margin="{StaticResource SidebarPad}">
        <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource Space5}">
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Settings}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Settings}"
                  ToolTip.Tip="{l:TK window.settings, Keys=7}">
            <c:Icon Glyph="settings" />
          </Button>
        </StackPanel>

        <StackPanel Spacing="{StaticResource Space5}">
          <Button Classes="sidebar" Classes.active="{Binding NowPlaying.IsVisible}"
                  Command="{Binding ToggleNowPlayingCommand}"
                  ToolTip.Tip="{l:T window.game_player_transport_song}">
            <c:Icon Glyph="play_circle" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Layout}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Layout}"
                  ToolTip.Tip="{l:TK window.layout, Keys=1}">
            <c:Icon Glyph="table_chart" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Sources}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Sources}"
                  ToolTip.Tip="{l:TK window.song_sources, Keys=2}">
            <c:Icon Glyph="library_music" />
          </Button>
          <!-- Output before input: the mics are calibrated for the game output, so it is chosen first. -->
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=AudioOutput}"
                  IsEnabled="{Binding !AudioLocked}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.AudioOutput}"
                  ToolTip.Tip="{l:TK window.audio_output, Keys=3}">
            <c:Icon Glyph="speaker" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=AudioInput}"
                  IsEnabled="{Binding !AudioLocked}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.AudioInput}"
                  ToolTip.Tip="{l:TK window.audio_input_players_microphones, Keys=4}">
            <c:Icon Glyph="mic_external_on" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Displays}"
                  IsEnabled="{Binding !AudioLocked}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Displays}"
                  ToolTip.Tip="{l:TK window.game_displays, Keys=5}">
            <c:Icon Glyph="tv" Classes.single="{Binding IsSingleScreen}" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Songbook}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Songbook}"
                  ToolTip.Tip="{l:TK window.songbook_guests_phone, Keys=6}">
            <c:Icon Glyph="phone_iphone" />
          </Button>
        </StackPanel>
      </DockPanel>
      </Panel>
    </Border>

    <!-- ── Centre: library + popover overlay ─────────────────────────────────────── -->
    <Panel Grid.Column="1">
      <ContentControl Content="{Binding Library}" />

    </Panel>

    <!-- ── Right panel: preview player + queue ──────────────────────────────────── -->
    <Border Grid.Column="2"
            Width="{StaticResource RightPanelWidth}"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushOutlineVariant}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <ContentControl Grid.Row="0" Content="{Binding Preview}" />
        <ContentControl Grid.Row="1" Content="{Binding Queue}" />
      </Grid>
    </Border>


    <!-- Floating layers of the main grid: the Game Player card lies over library and right column (ZIndex 1),
         the sidebar popover over the card (ZIndex 2). Toasts and the dialog stay above everything. -->
    <!-- Floating Game Player card (NowPlaying* in code) (draggable by its header; position persisted).
         Nothing between the Canvas and the card may clip, or the card's shadow is cut to a square. -->
    <Canvas Grid.ColumnSpan="3" ZIndex="1">
      <Canvas.Styles>
        <Style Selector="ContentControl.unclipped, ContentControl.unclipped /template/ ContentPresenter">
          <Setter Property="ClipToBounds" Value="False" />
        </Style>
      </Canvas.Styles>
      <ContentControl Classes="unclipped" Content="{Binding NowPlaying}"
                      Canvas.Left="{Binding NowPlaying.CardX}" Canvas.Top="{Binding NowPlaying.CardY}"
                      IsVisible="{Binding NowPlaying.IsVisible}" />
    </Canvas>

    <!-- Sidebar popover (above the Game Player card, ZIndex 2) anchored to the sidebar edge; capped to the window height, content scrolls.
         Closes on a press anywhere outside it and the sidebar (DjWindow.axaml.cs). -->
    <Border Grid.Column="1" ZIndex="2" Classes="popover" x:Name="Popover" Classes.bottom="{Binding PanelAtBottom}" Classes.fit="{Binding PanelFitsContent}"
            HorizontalAlignment="Left"
            Margin="{StaticResource PopoverMargin}"
            IsVisible="{Binding PanelContent, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,0,0,1"
                Padding="0,0,0,8" Margin="0,0,0,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Grid.Column="0" Glyph="{Binding PanelGlyph}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding PanelTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="sidebar" Width="28" Height="28" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T window.close}">
              <c:Icon Glyph="close" FontSize="{StaticResource IconMd}" />
            </Button>
          </Grid>
        </Border>
        <!-- Fluent's scrollbar floats over the content: the content keeps 16 px free on the right for it, and the
             popover is that much wider (PopoverWidth), so the content itself keeps its width. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding PanelContent}" Margin="0,0,16,0" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>

  <!-- Toasts (centre of the window, where the eye is): things that happened. Auto-dismiss (warnings stay longer), ✕ closes early. -->
  <ItemsControl Classes="toasts" ItemsSource="{Binding Notifications.Toasts}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="{StaticResource ToastWidth}">
    <!-- Nothing around a toast may clip, or its shadow is cut to a square (as with the Now Playing card). -->
    <ItemsControl.Styles>
      <Style Selector="ItemsControl.toasts, ItemsControl.toasts /template/ Border, ItemsControl.toasts /template/ ItemsPresenter, ItemsControl.toasts StackPanel, ItemsControl.toasts ContentPresenter">
        <Setter Property="ClipToBounds" Value="False" />
      </Style>
    </ItemsControl.Styles>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="svc:Toast">
        <Border Classes="card floating" Margin="0,0,0,8" Padding="30" Classes.warn="{Binding IsWarning}" Classes.success="{Binding IsSuccess}" Classes.request="{Binding IsRequest}">
          <Border.Styles>
            <Style Selector="Border.warn">
              <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
            </Style>
            <Style Selector="Border.warn c|Icon.kind">
              <Setter Property="Foreground" Value="{DynamicResource BrushError}" />
            </Style>
            <Style Selector="Border.success c|Icon.kind">
              <Setter Property="Foreground" Value="{DynamicResource BrushTertiary}" />
            </Style>
            <Style Selector="Border.request">
              <Setter Property="Background" Value="{DynamicResource BrushRequest}" />
            </Style>
          </Border.Styles>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Classes="kind" Glyph="{Binding Glyph}" FontSize="{StaticResource IconLg}" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Title}" FontSize="{StaticResource TextLg}" FontWeight="{StaticResource WeightSemibold}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="{StaticResource TextBase}" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="0,12,0,0" IsVisible="{Binding HasAction}">
                <Button Classes="tonal" Content="{Binding ActionLabel}"
                        Command="{Binding $parent[Window].((vm:DjWindowViewModel)DataContext).RunToastActionCommand}" CommandParameter="{Binding}" />
                <Button Classes="text" Content="{Binding DismissLabel}"
                        Command="{Binding $parent[Window].((vm:DjWindowViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="sidebar small" VerticalAlignment="Top" Margin="8,-4,-4,0" ToolTip.Tip="{l:T window.dismiss}"
                    Command="{Binding $parent[Window].((vm:DjWindowViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding}">
              <c:Icon Glyph="close" FontSize="{StaticResource IconMd}" />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

  <!-- Library → Details: song popup in the middle of the window. A press on the dimmed area or Esc closes it. -->
  <Border x:Name="DetailsLayer" Background="#99000000" Padding="40" IsVisible="{Binding SongDetails, Converter={x:Static ObjectConverters.IsNotNull}}"
          PointerPressed="OnDetailsBackdropPressed">
    <ContentControl Content="{Binding SongDetails}" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Border>

  <!-- A duet was loaded: who sings voice 1 and who voice 2 (DuetSingersViewModel). A press on the dimmed area or
       Esc keeps the current pick. -->
  <!-- First start: which language? Picking one switches the app at once (the window behind follows); OK keeps it. -->
  <Border Background="#99000000" IsVisible="{Binding ChooseLanguage}" ZIndex="10">
    <!-- The list scrolls when the window is low (small laptop screens), so OK always stays visible. -->
    <Border Classes="card floating" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Pad6}"
            Margin="{StaticResource Pad6}" Width="380">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource Space3}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <c:Icon Glyph="translate" />
          <TextBlock Classes="title" Text="{l:T language.title}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="muted" FontSize="{StaticResource TextSm}" Text="{l:T language.hint}" TextWrapping="Wrap" />
        <ListBox Grid.Row="2" ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding LanguageChoice}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="l:UiLanguage">
              <TextBlock Text="{Binding NativeName}" FontSize="{StaticResource TextLg}" Margin="4,2" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="3" Classes="tonal go" HorizontalAlignment="Right" Padding="20,8" Command="{Binding ConfirmLanguageCommand}" Content="{l:T language.ok}" />
      </Grid>
    </Border>
  </Border>

  <!-- Single-screen mode: the game fills this window from "Get ready" until back to the DJ view (DisplayService.GameLayer).
       Over everything; keys and mouse are its own (DjWindow.axaml.cs). -->
  <ContentControl x:Name="GameLayerHost" ZIndex="30" Background="{DynamicResource BrushBeamerBackground}" Focusable="True"
                  Content="{Binding GameLayer}" IsVisible="{Binding GameLayer, Converter={x:Static ObjectConverters.IsNotNull}}">
    <ContentControl.ContentTemplate>
      <DataTemplate x:DataType="vm:BeamerViewModel">
  <Panel>
    <v:DisplayView />
        <!-- The DJ's controls: during the song on mouse movement (Pause / Continue, Stop), on the score screen always
             (Back to DJ window). At the top, never over the lyrics. -->
      <Border x:Name="ControlBar" IsVisible="{Binding BarVisible}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{StaticResource Pad6}"
              Background="#CC000000" CornerRadius="{StaticResource RadiusFull}" Padding="12,10">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
          <Button Classes="transport" Classes.go="{Binding IsPaused}" Classes.pause="{Binding !IsPaused}" Command="{Binding TogglePauseCommand}"
                  IsVisible="{Binding IsGame}"
                  ToolTip.Tip="{l:Pick IsPaused, True=single.tip_continue, False=single.tip_pause}">
            <c:Icon Glyph="{Binding IsPaused, Converter={x:Static vm:BoolConverters.Glyph}, ConverterParameter='play_arrow|pause'}" FontSize="{StaticResource IconXl}" />
          </Button>
          <Button Classes="transport stop" Command="{Binding StopSongCommand}" ToolTip.Tip="{l:T single.tip_stop}"
                  IsVisible="{Binding IsGame}">
            <c:Icon Glyph="stop" FontSize="{StaticResource IconLg}" />
          </Button>
          <!-- The song's volume — the Game Player's "Song" fader (one setting); ↑ / ↓ change it in 5 % steps. -->
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding IsGame}" VerticalAlignment="Center"
                      Margin="8,0,4,0" ToolTip.Tip="{l:T single.tip_volume}">
            <c:Icon Glyph="volume_up" FontSize="{StaticResource IconMd}" Foreground="White" VerticalAlignment="Center" />
            <c:MeterFader Width="180" Minimum="0" Maximum="1" ResetValue="0.8" VerticalAlignment="Center"
                          MinDb="-40" MaxDb="0" WarnDb="-8" ClipDb="-4"
                          Value="{Binding $parent[Window].((vm:DjWindowViewModel)DataContext).NowPlaying.Gain}"
                          Level="{Binding $parent[Window].((vm:DjWindowViewModel)DataContext).NowPlaying.SongLevel}" />
            <TextBlock Foreground="White" FontSize="{StaticResource TextSm}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                       Text="{Binding $parent[Window].((vm:DjWindowViewModel)DataContext).NowPlaying.Gain, StringFormat='{}{0:P0}'}" />
          </StackPanel>
          <Button Classes="tonal" Command="{Binding BackToDjCommand}" VerticalAlignment="Center" Padding="16,10" IsVisible="{Binding IsScore}"
                ToolTip.Tip="{l:T single.tip_back}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <c:Icon Glyph="arrow_back" FontSize="{StaticResource IconMd}" />
              <TextBlock Text="{l:T single.back_to_dj}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
  </Panel>
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>

  <!-- Keyboard shortcuts ("?", the status bar's Shortcuts, the macOS app menu): every group with its keys, from
       ShortcutList. A press on the dimmed area or Esc closes it. -->
  <Border x:Name="ShortcutsLayer" Background="#99000000" IsVisible="{Binding ShortcutsOpen}" ZIndex="9"
          PointerPressed="OnShortcutsBackdropPressed">
    <Border Classes="card floating" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Pad6}"
            Margin="{StaticResource Pad6}" MaxWidth="980">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <c:Icon Glyph="keyboard" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Classes="title" Text="{l:T shortcuts.title}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="sidebar small" Command="{Binding CloseShortcutsCommand}" ToolTip.Tip="{l:TK window.close, Keys=Esc}">
            <c:Icon Glyph="close" FontSize="{StaticResource IconMd}" />
          </Button>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ShortcutGroups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutGroup">
                <StackPanel Width="300" Margin="0,0,24,16" Spacing="6">
                  <TextBlock Classes="label" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShortcutRow">
                        <Grid ColumnDefinitions="110,*" Margin="0,2">
                          <Border Background="{DynamicResource BrushSurfaceContainerHighest}" CornerRadius="{StaticResource RadiusSm}"
                                  Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Keys}" FontSize="{StaticResource TextSm}" FontWeight="{StaticResource WeightSemibold}" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{StaticResource TextSm}" TextWrapping="Wrap" Margin="8,1,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <!-- Single-screen mode explained (Game Displays → ⓘ): two screens and one, each in a sentence and a picture.
       A press on the dimmed area closes it; the Game Displays panel stays open behind it. -->
  <Border x:Name="SingleScreenInfoLayer" Background="#99000000" IsVisible="{Binding SingleScreenInfoOpen}" ZIndex="9"
          PointerPressed="OnSingleScreenInfoBackdropPressed">
    <Border Classes="card floating" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Pad6}"
            Margin="{StaticResource Pad6}" Width="560">
      <StackPanel Spacing="{StaticResource Space3}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="{l:T single.multi_title}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="sidebar small" Command="{Binding CloseSingleScreenInfoCommand}" ToolTip.Tip="{l:T window.close}">
            <c:Icon Glyph="close" FontSize="{StaticResource IconMd}" />
          </Button>
        </Grid>
        <TextBlock TextWrapping="Wrap" Text="{l:T single.multi_text}" />
        <c:ScreensPicture Single="False" Margin="0,4,0,8" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <c:Icon Glyph="tv" Foreground="{DynamicResource BrushSingleScreen}" VerticalAlignment="Center" />
          <TextBlock Classes="title" Text="{l:T single.title}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{l:T single.single_text}" />
        <c:ScreensPicture Single="True" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Border>

  <!-- A newer version on GitHub Releases (UpdateService): Update now downloads with progress and restarts into it. -->
  <Border Background="#99000000" IsVisible="{Binding ShowUpdate}" ZIndex="9">
    <Border Classes="card floating" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Pad6}" Width="420">
      <StackPanel Spacing="{StaticResource Space3}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <c:Icon Glyph="system_update" />
          <TextBlock Classes="title" Text="{l:T update.title}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{l:Format Updates.NewVersion, update.text}" />
        <TextBlock Classes="muted" FontSize="{StaticResource TextSm}" TextWrapping="Wrap"
                   Text="{l:Format Updates.CurrentVersion, update.current}" />
        <StackPanel Spacing="{StaticResource Space1}" IsVisible="{Binding Updates.IsDownloading}">
          <TextBlock FontSize="{StaticResource TextSm}" Text="{l:Format Updates.Progress, update.downloading}" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.Progress}" />
        </StackPanel>
        <TextBlock Foreground="{DynamicResource BrushError}" FontSize="{StaticResource TextSm}" TextWrapping="Wrap"
                   Text="{Binding Updates.Error}" IsVisible="{Binding Updates.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space2}"
                    IsEnabled="{Binding !Updates.IsDownloading}">
          <Button Classes="text" Padding="16,8" Command="{Binding UpdateLaterCommand}" Content="{l:T update.later}" />
          <Button Classes="tonal go" Padding="20,8" Command="{Binding UpdateNowCommand}" Content="{l:T update.now}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border x:Name="DuetLayer" Background="#99000000" IsVisible="{Binding DuetSingers, Converter={x:Static ObjectConverters.IsNotNull}}"
          PointerPressed="OnDuetBackdropPressed">
    <Border Classes="card floating" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Pad6}" MinWidth="460"
            DataContext="{Binding DuetSingers}" x:DataType="vm:DuetSingersViewModel">
      <StackPanel Spacing="{StaticResource Space3}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <c:Icon Glyph="group" />
          <TextBlock Classes="title" Text="{l:Format Title, window.duet_title}" TextTrimming="CharacterEllipsis" MaxWidth="460" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="{StaticResource TextSm}" Text="{l:T window.who_sings_which_voice}"
                   IsVisible="{Binding ShowTable}" />
        <TextBlock Text="{Binding OnlyOneText}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" IsVisible="{Binding OnlyOnePlayer}" />

        <!-- Two voice columns, each on its own tint with a divider between them; one radio group per player. A player
             with neither voice checked sits out. Each display is a block under a line. -->
        <StackPanel IsVisible="{Binding ShowTable}">
          <StackPanel.Styles>
            <Style Selector="Border.voice1">
              <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerHigh}" />
              <Setter Property="BorderBrush" Value="{DynamicResource BrushOutlineVariant}" />
              <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>
            <Style Selector="Border.voice2">
              <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerHighest}" />
            </Style>
          </StackPanel.Styles>
          <Grid ColumnDefinitions="160,170,170">
            <Border Grid.Column="1" Classes="voice1" CornerRadius="8,0,0,0" Padding="8,6">
              <TextBlock Classes="label" Text="{Binding Voice1Label}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>
            <Border Grid.Column="2" Classes="voice2" CornerRadius="0,8,0,0" Padding="8,6">
              <TextBlock Classes="label" Text="{Binding Voice2Label}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DuetDisplaySection">
                <StackPanel>
                  <Grid ColumnDefinitions="160,170,170">
                    <Border Grid.Column="1" Classes="voice1" />
                    <Border Grid.Column="2" Classes="voice2" />
                    <!-- The line between displays runs across the voice columns too. -->
                    <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                      <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" FontWeight="{StaticResource WeightSemibold}" Text="{Binding Title}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DuetSingerRow">
                        <Grid ColumnDefinitions="160,170,170" Height="36">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{Binding ColorKey, Converter={x:Static vm:PlayerConverters.BrushByKey}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                          </StackPanel>
                          <Border Grid.Column="1" Classes="voice1">
                            <c:ToggleRadioButton IsChecked="{Binding IsVoice1}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Grid.Column="2" Classes="voice2">
                            <c:ToggleRadioButton IsChecked="{Binding IsVoice2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="160,170,170" Height="8">
            <Border Grid.Column="1" Classes="voice1" CornerRadius="0,0,0,8" />
            <Border Grid.Column="2" Classes="voice2" CornerRadius="0,0,8,0" />
          </Grid>
        </StackPanel>

        <TextBlock Text="{Binding BothVoicesHint}" FontWeight="{StaticResource WeightSemibold}" IsVisible="{Binding ShowTable}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space2}">
          <Button Classes="tonal" Command="{Binding SwapCommand}" ToolTip.Tip="{l:T window.swap_two_voices}" IsVisible="{Binding ShowTable}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
              <c:Icon Glyph="swap_vert" FontSize="{StaticResource IconMd}" />
              <TextBlock Text="{l:T window.swap}" />
            </StackPanel>
          </Button>
          <Button Classes="tonal go" Command="{Binding OkCommand}" IsDefault="True" ToolTip.Tip="{l:T window.pick_least_one_singer}" ToolTip.ShowOnDisabled="True">
            <TextBlock Text="OK" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <!-- Error / bug dialog: an action the DJ started failed, or an unexpected exception. Queued; OK shows the next. -->
  <Border Background="#99000000" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Border Classes="card floating" Width="520" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Pad6}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="0,0,0,12">
          <c:Icon Glyph="{Binding Dialog.IsBug, Converter={x:Static vm:BoolConverters.Glyph}, ConverterParameter='bug_report|error'}"
                  Foreground="{DynamicResource BrushError}" />
          <TextBlock Classes="title" Text="{Binding Dialog.Title}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space2}" Margin="0,16,0,0">
          <Button Classes="text" Content="{l:T window.show_details}" Command="{Binding ToggleDialogDetailsCommand}" IsVisible="{Binding Dialog.HasDetails}" />
          <Button Classes="text" Content="{l:T window.copy_details}" Click="OnCopyDialogDetails" IsVisible="{Binding Dialog.IsBug}" />
          <Button Classes="text" Content="{l:T window.open_log_folder}" Click="OnOpenLogFolder" IsVisible="{Binding Dialog.IsBug}" />
          <Button Classes="tonal" Content="OK" Command="{Binding DismissDialogCommand}" IsDefault="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="{StaticResource Space2}">
            <ItemsControl ItemsSource="{Binding Dialog.Reasons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding DialogDetailsShown}" Background="{DynamicResource BrushSurfaceContainerLowest}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{StaticResource Pad2}">
              <SelectableTextBlock Text="{Binding Dialog.Details}" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>
  </Panel>
</Window>
