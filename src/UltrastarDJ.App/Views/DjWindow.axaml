<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UltrastarDJ.App.ViewModels"
        xmlns:c="using:UltrastarDJ.App.Controls"
        x:Class="UltrastarDJ.App.Views.DjWindow"
        x:DataType="vm:DjWindowViewModel"
        Title="Ultrastar DJ"
        Width="1400" Height="860"
        MinWidth="1100" MinHeight="700"
        Icon="avares://UltrastarDJ/Assets/icon.png"
        Background="{DynamicResource BrushBackground}">

  <Grid ColumnDefinitions="Auto,*,Auto">

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <Border Grid.Column="0"
            Width="{StaticResource SidebarWidth}"
            Background="{DynamicResource BrushSurfaceContainerLow}"
            BorderBrush="{DynamicResource BrushOutlineVariant}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="{StaticResource Pad2}">
        <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource Space1}">
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=MediaLab}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.MediaLab}"
                  ToolTip.Tip="Media Lab (Sprint 1 spike)">
            <c:Icon Glyph="science" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Settings}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Settings}"
                  ToolTip.Tip="Settings">
            <c:Icon Glyph="settings" />
          </Button>
        </StackPanel>

        <StackPanel Spacing="{StaticResource Space1}">
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Layout}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Layout}"
                  ToolTip.Tip="Layout">
            <c:Icon Glyph="table_chart" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Sources}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Sources}"
                  ToolTip.Tip="Song Sources">
            <c:Icon Glyph="library_music" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=AudioInput}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.AudioInput}"
                  ToolTip.Tip="Audio Input (players &amp; microphones)">
            <c:Icon Glyph="mic_external_on" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=AudioOutput}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.AudioOutput}"
                  ToolTip.Tip="Audio Output">
            <c:Icon Glyph="speaker" />
          </Button>
          <Button Classes="sidebar" Classes.active="{Binding ActivePanel, Converter={x:Static vm:SidebarPanelConverters.Is}, ConverterParameter=Displays}"
                  Command="{Binding TogglePanelCommand}" CommandParameter="{x:Static vm:SidebarPanel.Displays}"
                  ToolTip.Tip="Displays">
            <c:Icon Glyph="tv" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Centre: library + popover overlay ─────────────────────────────────────── -->
    <Panel Grid.Column="1">
      <ContentControl Content="{Binding Library}" />

      <!-- Popover anchored to the sidebar edge; capped to the window height, content scrolls -->
      <Border Classes="popover"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="{StaticResource Pad2}"
              IsVisible="{Binding PanelContent, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
          <ContentControl Content="{Binding PanelContent}" />
        </ScrollViewer>
      </Border>
    </Panel>

    <!-- ── Right panel: preview player + queue (placeholders) ──────────── -->
    <Border Grid.Column="2"
            Width="{StaticResource RightPanelWidth}"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushOutlineVariant}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <ContentControl Grid.Row="0" Content="{Binding NowPlaying}" />
        <Border Grid.Row="1" Padding="{StaticResource Pad3}" BorderBrush="{DynamicResource BrushOutlineVariant}" BorderThickness="0,1,0,1">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="label" Text="PREVIEW PLAYER" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="sidebar" Width="28" Height="28" Command="{Binding Library.TogglePreviewCommand}" ToolTip.Tip="Play / pause preview">
              <c:Icon Glyph="play_pause" FontSize="{StaticResource IconMd}" />
            </Button>
            <Button Grid.Column="2" Classes="sidebar" Width="28" Height="28" Command="{Binding Library.StopPreviewCommand}" ToolTip.Tip="Stop preview">
              <c:Icon Glyph="stop" FontSize="{StaticResource IconMd}" />
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="2" Margin="{StaticResource Pad3}" Background="{DynamicResource BrushBeamerBackground}"
                CornerRadius="{StaticResource RadiusMd}" Height="160" ClipToBounds="True">
          <Panel>
            <c:VideoSurface Source="{Binding Library.PreviewFrames}" />
            <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" Margin="8" VerticalAlignment="Bottom"
                       Text="{Binding Library.Previewing.Title}" TextTrimming="CharacterEllipsis" />
          </Panel>
        </Border>
        <TextBlock Grid.Row="3" Foreground="{DynamicResource BrushError}" FontSize="{StaticResource TextXs}" Margin="12,0" TextWrapping="Wrap"
                   Text="{Binding Library.PreviewError}" IsVisible="{Binding Library.PreviewError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Grid.Row="4" Classes="muted" Text="Queue arrives in Sprint 5" Margin="{StaticResource Pad3}" />
      </Grid>
    </Border>

  </Grid>
</Window>
