<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UltrastarDJ.App.ViewModels"
             xmlns:c="using:UltrastarDJ.App.Controls"
             x:Class="UltrastarDJ.App.Views.DisplaysPanelView"
             x:DataType="vm:DisplaysPanelViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="DisplayRow" x:DataType="vm:DisplayRowViewModel">
      <Border Classes="card" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="title" Text="{Binding Title}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <c:Icon Glyph="tv" IsVisible="{Binding IsOpen}" Foreground="{DynamicResource BrushPrimary}" />
            <TextBlock Classes="muted" VerticalAlignment="Center"
                       Text="{Binding IsOpen, Converter={x:Static vm:BoolConverters.OpenClosed}}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="0,12,0,0">
            <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:DisplaysPanelViewModel)DataContext).Screens}"
                      SelectedItem="{Binding SelectedScreen}"
                      IsEnabled="{Binding !IsOpen}"
                      MinWidth="220">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="tonal" Command="{Binding OpenCommand}" Content="Open" />
            <Button Classes="tonal" Command="{Binding CloseCommand}" Content="Close" />
          </StackPanel>

          <!-- Which players sing on this screen (a player can be on one screen only) -->
          <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Players}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlayerToggleViewModel">
                <ToggleButton IsChecked="{Binding IsOn}" IsEnabled="{Binding HasMic}" Margin="0,0,8,8" Padding="12,6"
                              ToolTip.Tip="{Binding HasMic, Converter={x:Static vm:PlayerConverters.MicTooltip}}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="10" Height="10" CornerRadius="{StaticResource RadiusFull}" VerticalAlignment="Center"
                            Background="{Binding ColorKey, Converter={x:Static vm:PlayerConverters.BrushByKey}}" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="{StaticResource Space2}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <c:Icon Grid.Column="0" Glyph="tv" Margin="0,0,8,0" />
      <TextBlock Grid.Column="1" Classes="title" Text="Displays" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="sidebar" Command="{Binding RefreshScreensCommand}" ToolTip.Tip="Refresh screen list">
        <c:Icon Glyph="refresh" FontSize="{StaticResource IconMd}" />
      </Button>
    </Grid>

    <ContentControl Content="{Binding Beamer1}" ContentTemplate="{StaticResource DisplayRow}" />
    <ContentControl Content="{Binding Beamer2}" ContentTemplate="{StaticResource DisplayRow}" />

    <TextBlock Classes="muted" FontSize="{StaticResource TextXs}" TextWrapping="Wrap"
               Text="Players need a microphone (Audio Input) before they can be put on a screen." />
  </StackPanel>
</UserControl>
