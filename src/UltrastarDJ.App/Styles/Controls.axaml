<!--
  Control styles built on the tokens. One selector group per control family.
  Add a class here when the same look is needed in more than one view.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:UltrastarDJ.App.Controls">

  <!-- Base text: windows set the inherited size; TextBlocks without an explicit size follow it -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource TextBase}" />
    <!-- Settings → Show tooltips. Inherited by every control in the window. -->
    <Setter Property="ToolTip.ServiceEnabled" Value="{DynamicResource ShowTooltips}" />
    <!-- Disabled controls still explain themselves ("why can't I click this?"). Inherited. -->
    <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurfaceVariant}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource TextXl}" />
    <Setter Property="FontWeight" Value="{StaticResource WeightSemibold}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource TextXs}" />
    <Setter Property="FontWeight" Value="{StaticResource WeightSemibold}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurfaceVariant}" />
  </Style>

  <!-- Pointing hand on everything clickable (the prototype's cursor: pointer); text inputs keep the I-beam -->
  <Style Selector=":is(Button), ComboBox, ComboBoxItem, MenuItem, ToggleSwitch, CheckBox">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- The app's disabled state: dimmed to OpacityDisabled, normal arrow (Fluent's own disabled look is too subtle) -->
  <Style Selector=":is(Button):disabled, ComboBox:disabled, ToggleSwitch:disabled, CheckBox:disabled, Slider:disabled, TextBox:disabled, MenuItem:disabled, ComboBoxItem:disabled">
    <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Icon glyphs -->
  <Style Selector="c|Icon">
    <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
    <Setter Property="FontSize" Value="{StaticResource IconLg}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurfaceVariant}" />
  </Style>

  <!-- Sidebar icon button -->
  <Style Selector="Button.sidebar">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Disabled: no background (Fluent would paint a grey one), just the app-wide dimming -->
  <Style Selector="Button.sidebar:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- Interaction states shared with library rows and toggles (BrushState* tokens) -->
  <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateHover}" />
  </Style>
  <Style Selector="Button.sidebar:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStatePressed}" />
  </Style>
  <Style Selector="Button.sidebar.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelected}" />
  </Style>
  <Style Selector="Button.sidebar.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelectedHover}" />
  </Style>
  <Style Selector="Button.sidebar.active c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
  </Style>
  <Style Selector="Button.sidebar.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>

  <!-- Buttons, one look per job:
         tonal            = normal action (Add to queue, Load, Fullscreen…): light blue tint, thin outline, soft shadow
         tonal.go         = starts / opens something (Start, Open, Test, Play): filled green
         tonal.stop       = stops / closes it again (Stop, Close): filled red
       A start/stop pair is one button that swaps go ↔ stop. The Game Player's round transport uses the same colours. -->
  <Style Selector="Button.tonal">
    <Setter Property="Background" Value="{DynamicResource BrushButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Color="Black" Opacity="0.18" />
    </Setter>
  </Style>
  <Style Selector="Button.tonal:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushButtonHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}" />
  </Style>
  <Style Selector="Button.tonal:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}" />
  </Style>
  <!-- Disabled keeps its look, only dimmed (the app-wide disabled rule) — Fluent would turn it grey. -->
  <Style Selector="Button.tonal:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}" />
  </Style>
  <!-- Icon + text side by side: both centred on the button's middle (a TextBlock alone would sit at the top of the
       taller icon line, a few px too high). -->
  <Style Selector="Button StackPanel[Orientation=Horizontal] > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Toggle buttons (player chips, monitor): checked = selected state, not Fluent's solid accent -->
  <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateHover}" />
  </Style>
  <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStatePressed}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelectedHover}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
  </Style>
  <Style Selector="ToggleButton:checked c|Icon, ToggleButton:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
  </Style>

  <!-- List rows (library, drop-down lists): the same states, explicitly, so they follow the tokens -->
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateHover}" />
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStatePressed}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelected}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStateSelectedHover}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStatePressed}" />
  </Style>

  <!-- Round transport buttons (Game Player 48 px, Preview Player .small 36 px): play = go, pause = normal tint, stop = stop -->
  <Style Selector="Button.transport">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.transport.small">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Button.transport.pause /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.transport.pause:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushButtonHover}" />
  </Style>

  <!-- Foregrounds and the go / stop fills: after the tonal and transport looks so they win. -->
  <!-- Only the button's own content (direct child, or inside its one StackPanel): a plain "Button.go TextBlock" also
       reaches the tooltip's text, because a tooltip is a logical child of its control (white text on a light tooltip). -->
  <Style Selector="Button.tonal > TextBlock, Button.tonal > StackPanel > TextBlock, Button.tonal > StackPanel > c|Icon, Button.transport > c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnButton}" />
  </Style>
  <Style Selector="Button.go /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushGo}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushGo}" />
  </Style>
  <Style Selector="Button.go:pointerover /template/ ContentPresenter, Button.go:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushGoHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushGoHover}" />
  </Style>
  <Style Selector="Button.stop /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStop}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushStop}" />
  </Style>
  <Style Selector="Button.stop:pointerover /template/ ContentPresenter, Button.stop:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushStopHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushStopHover}" />
  </Style>
  <Style Selector="Button.go > TextBlock, Button.go > StackPanel > TextBlock, Button.go > StackPanel > c|Icon, Button.go > c|Icon,
                   Button.stop > TextBlock, Button.stop > StackPanel > TextBlock, Button.stop > StackPanel > c|Icon, Button.stop > c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnGoStop}" />
  </Style>

  <!-- Text button (low-emphasis action, e.g. "Clear" filters) -->
  <Style Selector="Button.text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.text:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerHigh}" />
  </Style>
  <Style Selector="Button.text c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
  </Style>

  <!-- Borderless text box that reads like a label until focused (player names) -->
  <Style Selector="TextBox.inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="FontWeight" Value="{StaticResource WeightSemibold}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Card surface -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainer}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource PadCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushOutlineVariant}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- One look for everything that floats above the layout: sidebar popovers and the Now Playing card.
       No shadow spread: Avalonia draws a spread shadow with square corners. -->
  <Style Selector="Border.popover, Border.card.floating">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceContainerLow}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushOutlineVariant}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowOverlay}" />
  </Style>

  <Style Selector="Border.card.floating">
    <Setter Property="Padding" Value="{StaticResource PadPanel}" />
  </Style>

  <!-- Context menus, ⋮ menus and ComboBox drop-downs: same shadow, room for it inside their popup window -->
  <!-- Margin and shadow sit on the template's frame (as for the ComboBox's PopupBorder), so the room is part of the
       popup's content; a margin on the menu control itself did not give the shadow room. -->
  <Style Selector="ContextMenu">
    <Setter Property="HorizontalOffset" Value="{StaticResource ShadowRoomOffsetX}" />
    <Setter Property="VerticalOffset" Value="{StaticResource ShadowRoomOffsetY}" />
  </Style>
  <Style Selector="ContextMenu /template/ Border, MenuFlyoutPresenter /template/ Border#LayoutRoot">
    <Setter Property="Margin" Value="{StaticResource ShadowRoom}" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowOverlay}" />
  </Style>
  <Style Selector="ComboBox /template/ Popup#PART_Popup">
    <Setter Property="HorizontalOffset" Value="{StaticResource ShadowRoomOffsetX}" />
    <Setter Property="VerticalOffset" Value="{StaticResource ShadowRoomOffsetY}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Margin" Value="{StaticResource ShadowRoom}" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowOverlay}" />
    <!-- The popup's own MinWidth (= ComboBox width) now includes the shadow room; keep the list as wide as the box. -->
    <Setter Property="MinWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" />
  </Style>

  <!-- Popover panel anchored next to the sidebar: top, or bottom for buttons at the sidebar's bottom (Settings) -->
  <Style Selector="Border.popover">
    <Setter Property="Padding" Value="{StaticResource PadPanel}" />
    <Setter Property="Width" Value="{StaticResource PopoverWidth}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <!-- Content decides the width (at least the usual one): the Displays panel's player buttons stay on one line. -->
  <Style Selector="Border.popover.fit">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MinWidth" Value="{StaticResource PopoverWidth}" />
  </Style>
  <Style Selector="Border.popover.bottom">
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <!-- Menu icons: Fluent squeezes the icon into a 16 × 16 box with a 12 px gap; ours are 24 px with a small gap. -->
  <Style Selector="MenuItem /template/ :is(Control)#PART_IconPresenter">
    <Setter Property="Width" Value="{StaticResource IconLg}" />
    <Setter Property="Height" Value="{StaticResource IconLg}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <!-- Text on the stage (beamers and the Game Player's box, which mirrors them): sits on pictures and video, so a
       soft dark shadow keeps it readable on bright frames (white screens). -->
  <Style Selector="TextBlock.beamer">
    <Setter Property="Foreground" Value="{DynamicResource BrushBeamerText}" />
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="2" BlurRadius="16" Color="Black" Opacity="0.85" />
    </Setter>
  </Style>
</Styles>