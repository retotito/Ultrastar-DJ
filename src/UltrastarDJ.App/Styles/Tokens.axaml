<!--
  Design tokens — the only place colours, spacing, typography and radii are defined.
  Ported 1:1 from the prototype's app.css. Views reference these via DynamicResource (colours/brushes)
  or StaticResource (sizes). Never hardcode values in a view.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Theme-dependent: colours ─────────────────────────────────────── -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="ColorPrimary">#90C8FF</Color>
      <Color x:Key="ColorOnPrimary">#003354</Color>
      <Color x:Key="ColorPrimaryContainer">#004B78</Color>
      <Color x:Key="ColorOnPrimaryContainer">#CCE5FF</Color>

      <Color x:Key="ColorSecondary">#A8C8E8</Color>
      <Color x:Key="ColorOnSecondary">#1A3348</Color>
      <Color x:Key="ColorSecondaryContainer">#2A4A62</Color>
      <Color x:Key="ColorOnSecondaryContainer">#D6EAF8</Color>

      <Color x:Key="ColorTertiary">#80CBC4</Color>
      <Color x:Key="ColorTertiaryContainer">#004D47</Color>

      <Color x:Key="ColorError">#F2B8B5</Color>
      <Color x:Key="ColorOnError">#601410</Color>
      <Color x:Key="ColorErrorContainer">#8C1D18</Color>

      <Color x:Key="ColorBackground">#121212</Color>
      <Color x:Key="ColorOnBackground">#E3E3E3</Color>
      <Color x:Key="ColorSurface">#121212</Color>
      <Color x:Key="ColorOnSurface">#E3E3E3</Color>
      <Color x:Key="ColorSurfaceVariant">#444444</Color>
      <Color x:Key="ColorOnSurfaceVariant">#C8C8C8</Color>

      <Color x:Key="ColorSurfaceContainerLowest">#0D0D0D</Color>
      <Color x:Key="ColorSurfaceContainerLow">#1A1A1A</Color>
      <Color x:Key="ColorSurfaceContainer">#1E1E1E</Color>
      <Color x:Key="ColorSurfaceContainerHigh">#282828</Color>
      <Color x:Key="ColorSurfaceContainerHighest">#333333</Color>

      <Color x:Key="ColorOutline">#8A8A8A</Color>
      <Color x:Key="ColorOutlineVariant">#444444</Color>
      <Color x:Key="ColorScrim">#000000</Color>

      <!-- Interaction states (selected / selected+hover / pressed) = Fluent's list highlight on the OS accent colour,
           so rows, navigation, icon buttons and toggles look alike. Dark: 0.6 / 0.8 / 0.9. -->
      <SolidColorBrush x:Key="BrushStateSelected" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="BrushStateSelectedHover" Color="{DynamicResource SystemAccentColor}" Opacity="0.8" />
      <SolidColorBrush x:Key="BrushStatePressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.9" />
      <!-- Zebra stripe: on-surface at 4%, as in the prototype -->
      <Color x:Key="ColorTableRowAlt">#0AFFFFFF</Color>
      <!-- Songbook requests: a light green wash, so guests' wishes stand out (REQUESTS, request toasts). -->
      <Color x:Key="ColorRequest">#1F3A2A</Color>
      <!-- Plain sliders (latency) like the toggle switches: filled part in the selected blue, knob in the text colour. -->
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.8" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.9" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource ColorOnSurface}" />
      <!-- Toggle switches "on" = the same selected blue as the sidebar's active button (Fluent's solid accent was too loud),
           knob in the text colour like the active sidebar icon. Overrides Fluent's own ToggleSwitch keys. -->
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.8" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.9" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource ColorOnSurface}" />
      <!-- Buttons: start (green) / stop (red), filled with white text; normal = a light blue tint with a thin outline. -->
      <Color x:Key="ColorGo">#2D9B57</Color>
      <Color x:Key="ColorGoHover">#36AD63</Color>
      <Color x:Key="ColorStop">#D93025</Color>
      <Color x:Key="ColorStopHover">#E8453C</Color>
      <Color x:Key="ColorButton">#1D3A52</Color>
      <Color x:Key="ColorButtonHover">#264B69</Color>
      <Color x:Key="ColorButtonBorder">#2F5878</Color>
      <Color x:Key="ColorOnButton">#D6EAF8</Color>
      <!-- The search box's clear X on hover: the 10 % hover tint, made opaque over the box's own background. -->
      <Color x:Key="ColorSearchClearHover">#323232</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="ColorPrimary">#1A73E8</Color>
      <Color x:Key="ColorOnPrimary">#FFFFFF</Color>
      <Color x:Key="ColorPrimaryContainer">#D3E3FD</Color>
      <Color x:Key="ColorOnPrimaryContainer">#041E49</Color>

      <Color x:Key="ColorSecondary">#4A5C6A</Color>
      <Color x:Key="ColorOnSecondary">#FFFFFF</Color>
      <Color x:Key="ColorSecondaryContainer">#DDE3EA</Color>
      <Color x:Key="ColorOnSecondaryContainer">#1F2A32</Color>

      <Color x:Key="ColorTertiary">#00796B</Color>
      <Color x:Key="ColorTertiaryContainer">#B2DFDB</Color>

      <Color x:Key="ColorError">#B3261E</Color>
      <Color x:Key="ColorOnError">#FFFFFF</Color>
      <Color x:Key="ColorErrorContainer">#F9DEDC</Color>

      <Color x:Key="ColorBackground">#F8F9FA</Color>
      <Color x:Key="ColorOnBackground">#1F1F1F</Color>
      <Color x:Key="ColorSurface">#FFFFFF</Color>
      <Color x:Key="ColorOnSurface">#1F1F1F</Color>
      <Color x:Key="ColorSurfaceVariant">#E1E3E1</Color>
      <Color x:Key="ColorOnSurfaceVariant">#444746</Color>

      <Color x:Key="ColorSurfaceContainerLowest">#FFFFFF</Color>
      <Color x:Key="ColorSurfaceContainerLow">#F3F4F6</Color>
      <Color x:Key="ColorSurfaceContainer">#EEF0F2</Color>
      <Color x:Key="ColorSurfaceContainerHigh">#E7E9EC</Color>
      <Color x:Key="ColorSurfaceContainerHighest">#DFE2E5</Color>

      <Color x:Key="ColorOutline">#747775</Color>
      <Color x:Key="ColorOutlineVariant">#C4C7C5</Color>
      <Color x:Key="ColorScrim">#000000</Color>

      <!-- Light: 0.4 / 0.6 / 0.7 (Fluent's light values) -->
      <SolidColorBrush x:Key="BrushStateSelected" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="BrushStateSelectedHover" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="BrushStatePressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
      <Color x:Key="ColorTableRowAlt">#0A000000</Color>
      <Color x:Key="ColorRequest">#E6F4EA</Color>
      <!-- Plain sliders (latency) like the toggle switches: filled part in the selected blue, knob in the text colour. -->
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource ColorOnSurface}" />
      <!-- Toggle switches "on" = the same selected blue as the sidebar's active button (Fluent's solid accent was too loud),
           knob in the text colour like the active sidebar icon. Overrides Fluent's own ToggleSwitch keys. -->
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource ColorOnSurface}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource ColorOnSurface}" />
      <Color x:Key="ColorGo">#1E8E3E</Color>
      <Color x:Key="ColorGoHover">#188038</Color>
      <Color x:Key="ColorStop">#C5221F</Color>
      <Color x:Key="ColorStopHover">#A50E0E</Color>
      <Color x:Key="ColorButton">#E3EDFB</Color>
      <Color x:Key="ColorButtonHover">#D3E3FD</Color>
      <Color x:Key="ColorButtonBorder">#C2D5F2</Color>
      <Color x:Key="ColorOnButton">#0B2A55</Color>
      <Color x:Key="ColorSearchClearHover">#E9E9E9</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ── Theme-independent: player accents, golden ────────────────────── -->
  <Color x:Key="ColorPlayer1">#4F8EF7</Color>
  <Color x:Key="ColorPlayer2">#F75F5F</Color>
  <Color x:Key="ColorPlayer3">#4ECB71</Color>
  <Color x:Key="ColorPlayer4">#F7C84F</Color>
  <Color x:Key="ColorGolden">#FFD700</Color>
  <Color x:Key="ColorUsdb">#2E9E5B</Color>
  <!-- Level meters (MeterFader): green → yellow → red, as in the Tauri app -->
  <Color x:Key="ColorMeterLow">#4ECB71</Color>
  <Color x:Key="ColorMeterWarn">#F7C84F</Color>
  <Color x:Key="ColorMeterClip">#F75F5F</Color>
  <Color x:Key="ColorBeamerBackground">#000000</Color>
  <Color x:Key="ColorBeamerText">#FFFFFF</Color>
  <!-- Stage time strip (beamer bottom, Game Player box): lead-in blue bar on a faint track, translucent time pills. -->
  <Color x:Key="ColorStageProgress">#4F8EF7</Color>
  <Color x:Key="ColorStageTrack">#33FFFFFF</Color>
  <Color x:Key="ColorStagePill">#26FFFFFF</Color>

  <!-- ── Brushes (bind to these in views; they follow the theme) ───────── -->
  <SolidColorBrush x:Key="BrushPrimary" Color="{DynamicResource ColorPrimary}" />
  <SolidColorBrush x:Key="BrushOnPrimary" Color="{DynamicResource ColorOnPrimary}" />
  <SolidColorBrush x:Key="BrushPrimaryContainer" Color="{DynamicResource ColorPrimaryContainer}" />
  <SolidColorBrush x:Key="BrushOnPrimaryContainer" Color="{DynamicResource ColorOnPrimaryContainer}" />
  <SolidColorBrush x:Key="BrushSecondaryContainer" Color="{DynamicResource ColorSecondaryContainer}" />
  <SolidColorBrush x:Key="BrushOnSecondaryContainer" Color="{DynamicResource ColorOnSecondaryContainer}" />
  <SolidColorBrush x:Key="BrushError" Color="{DynamicResource ColorError}" />
  <SolidColorBrush x:Key="BrushOnError" Color="{DynamicResource ColorOnError}" />
  <!-- The OS accent colour, solid -->
  <SolidColorBrush x:Key="BrushAccent" Color="{DynamicResource SystemAccentColor}" />
  <SolidColorBrush x:Key="BrushOnAccent" Color="White" />
  <SolidColorBrush x:Key="BrushTertiary" Color="{DynamicResource ColorTertiary}" />
  <SolidColorBrush x:Key="BrushBackground" Color="{DynamicResource ColorBackground}" />
  <SolidColorBrush x:Key="BrushSurface" Color="{DynamicResource ColorSurface}" />
  <SolidColorBrush x:Key="BrushOnSurface" Color="{DynamicResource ColorOnSurface}" />
  <SolidColorBrush x:Key="BrushOnSurfaceVariant" Color="{DynamicResource ColorOnSurfaceVariant}" />
  <SolidColorBrush x:Key="BrushSurfaceContainerLowest" Color="{DynamicResource ColorSurfaceContainerLowest}" />
  <SolidColorBrush x:Key="BrushSurfaceContainerLow" Color="{DynamicResource ColorSurfaceContainerLow}" />
  <SolidColorBrush x:Key="BrushSurfaceContainer" Color="{DynamicResource ColorSurfaceContainer}" />
  <SolidColorBrush x:Key="BrushSurfaceContainerHigh" Color="{DynamicResource ColorSurfaceContainerHigh}" />
  <SolidColorBrush x:Key="BrushSurfaceContainerHighest" Color="{DynamicResource ColorSurfaceContainerHighest}" />
  <SolidColorBrush x:Key="BrushOutline" Color="{DynamicResource ColorOutline}" />
  <SolidColorBrush x:Key="BrushOutlineVariant" Color="{DynamicResource ColorOutlineVariant}" />
  <SolidColorBrush x:Key="BrushTableRowAlt" Color="{DynamicResource ColorTableRowAlt}" />
  <SolidColorBrush x:Key="BrushRequest" Color="{DynamicResource ColorRequest}" />
  <!-- Mic gate on a MeterFader: shade over the range that counts as silence, and its drag handle -->
  <!-- Favourite songs: the heart in the library and the song details -->
  <SolidColorBrush x:Key="BrushFavourite" Color="#E91E63" />
  <SolidColorBrush x:Key="BrushGateZone" Color="{StaticResource ColorMeterClip}" Opacity="0.3" />
  <SolidColorBrush x:Key="BrushGateHandle" Color="{StaticResource ColorMeterClip}" />
  <SolidColorBrush x:Key="BrushGo" Color="{DynamicResource ColorGo}" />
  <SolidColorBrush x:Key="BrushGoHover" Color="{DynamicResource ColorGoHover}" />
  <SolidColorBrush x:Key="BrushStop" Color="{DynamicResource ColorStop}" />
  <SolidColorBrush x:Key="BrushStopHover" Color="{DynamicResource ColorStopHover}" />
  <SolidColorBrush x:Key="BrushOnGoStop" Color="White" />
  <SolidColorBrush x:Key="BrushButton" Color="{DynamicResource ColorButton}" />
  <SolidColorBrush x:Key="BrushButtonHover" Color="{DynamicResource ColorButtonHover}" />
  <SolidColorBrush x:Key="BrushButtonBorder" Color="{DynamicResource ColorButtonBorder}" />
  <SolidColorBrush x:Key="BrushOnButton" Color="{DynamicResource ColorOnButton}" />
  <SolidColorBrush x:Key="BrushSearchClearHover" Color="{DynamicResource ColorSearchClearHover}" />
  <!-- Neutral hover for rows and icon buttons (on-surface at 10%, like Fluent's list hover) -->
  <SolidColorBrush x:Key="BrushStateHover" Color="{DynamicResource ColorOnSurface}" Opacity="0.1" />
  <SolidColorBrush x:Key="BrushPlayer1" Color="{StaticResource ColorPlayer1}" />
  <SolidColorBrush x:Key="BrushPlayer2" Color="{StaticResource ColorPlayer2}" />
  <SolidColorBrush x:Key="BrushPlayer3" Color="{StaticResource ColorPlayer3}" />
  <SolidColorBrush x:Key="BrushPlayer4" Color="{StaticResource ColorPlayer4}" />
  <SolidColorBrush x:Key="BrushGolden" Color="{StaticResource ColorGolden}" />
  <SolidColorBrush x:Key="BrushUsdb" Color="{StaticResource ColorUsdb}" />
  <SolidColorBrush x:Key="BrushBeamerBackground" Color="{StaticResource ColorBeamerBackground}" />
  <SolidColorBrush x:Key="BrushBeamerText" Color="{StaticResource ColorBeamerText}" />
  <SolidColorBrush x:Key="BrushStageProgress" Color="{StaticResource ColorStageProgress}" />
  <SolidColorBrush x:Key="BrushStageTrack" Color="{StaticResource ColorStageTrack}" />
  <SolidColorBrush x:Key="BrushStagePill" Color="{StaticResource ColorStagePill}" />

  <!-- ── Spacing scale (px) ───────────────────────────────────────────── -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>
  <x:Double x:Key="Space10">40</x:Double>
  <x:Double x:Key="Space12">48</x:Double>

  <Thickness x:Key="Pad1">4</Thickness>
  <Thickness x:Key="Pad2">8</Thickness>
  <Thickness x:Key="Pad3">12</Thickness>
  <Thickness x:Key="Pad4">16</Thickness>
  <Thickness x:Key="Pad6">24</Thickness>
  <Thickness x:Key="PadCard">16</Thickness>
  <Thickness x:Key="PadPanel">12</Thickness>

  <!-- ── Typography ───────────────────────────────────────────────────── -->
  <FontFamily x:Key="FontSans">fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, Menlo, Consolas, monospace</FontFamily>
  <FontFamily x:Key="FontIcons">avares://UltrastarDJ/Assets/Fonts/MaterialSymbolsOutlined.ttf#Material Symbols Outlined</FontFamily>

  <x:Double x:Key="TextXs">12</x:Double>
  <x:Double x:Key="TextSm">14</x:Double>
  <x:Double x:Key="TextBase">16</x:Double>
  <x:Double x:Key="TextLg">18</x:Double>
  <x:Double x:Key="TextXl">20</x:Double>
  <x:Double x:Key="Text2Xl">24</x:Double>
  <x:Double x:Key="Text3Xl">30</x:Double>

  <x:Double x:Key="IconSm">16</x:Double>
  <x:Double x:Key="IconMd">20</x:Double>
  <x:Double x:Key="IconLg">24</x:Double>
  <x:Double x:Key="IconXl">32</x:Double>
  <!-- Disabled controls (and unavailable rows): one dimming level for the whole app -->
  <x:Double x:Key="OpacityDisabled">0.4</x:Double>

  <!-- Sidebar navigation glyphs; the prototype used 36px with 20px (Space5) gaps -->
  <x:Double x:Key="IconNav">36</x:Double>

  <!-- Body text everywhere without an explicit size (the prototype rendered ~16px). Overrides Fluent's 14px default
       for inputs, drop-downs and menus too. -->
  <x:Double x:Key="ControlContentThemeFontSize">16</x:Double>

  <FontWeight x:Key="WeightRegular">Normal</FontWeight>
  <FontWeight x:Key="WeightMedium">Medium</FontWeight>
  <FontWeight x:Key="WeightSemibold">SemiBold</FontWeight>
  <FontWeight x:Key="WeightBold">Bold</FontWeight>

  <!-- ── Shape ────────────────────────────────────────────────────────── -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>
  <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

  <!-- One shadow for everything floating: popovers, Now Playing, menus, drop-downs. No spread: Avalonia draws
       spread shadows with square corners. Menus/drop-downs live in their own popup windows, which end at their
       content: ShadowRoom is transparent margin inside the popup so the shadow is not cut off, and
       -ShadowRoom.Left/Top is the placement offset that keeps the visible menu where it was. -->
  <BoxShadows x:Key="ShadowOverlay">0 8 24 0 #99000000</BoxShadows>
  <Thickness x:Key="ShadowRoom">16,4,16,28</Thickness>
  <x:Double x:Key="ShadowRoomOffsetX">-16</x:Double>
  <x:Double x:Key="ShadowRoomOffsetY">-4</x:Double>

  <!-- ── Layout constants ─────────────────────────────────────────────── -->
  <x:Double x:Key="SidebarWidth">56</x:Double>
  <x:Double x:Key="RightPanelWidth">340</x:Double>
  <!-- The floating Game Player card: its minimum width (it grows with longer labels, e.g. translations) -->
  <x:Double x:Key="GamePlayerWidth">420</x:Double>
  <!-- 420 + 12: room between the content and the floating scrollbar -->
  <x:Double x:Key="PopoverWidth">432</x:Double>
  <!-- Text width inside a popover of PopoverWidth (minus PadPanel): hints in a wider popover keep it. -->
  <x:Double x:Key="PopoverTextWidth">396</x:Double>
  <!-- Picture box of the preview player and the Game Player: same width, so the same height keeps the same shape -->
  <x:Double x:Key="PlayerPictureHeight">170</x:Double>
  <!-- The Game Player's box, scaled with its extra width so the picture keeps the same shape -->
  <x:Double x:Key="GamePlayerPictureHeight">197</x:Double>

</ResourceDictionary>
